# Copia este archivo a .dev.vars y completa los valores. Nunca subas .dev.vars al repo.
MODEL_API_KEY=
# 32 bytes aleatorios en base64url
HMAC_ALLIANCE_KEY=
# 32 bytes aleatorios en base64url (AES-256-GCM)
EVIDENCE_ENCRYPTION_KEY=
JWT_SECRET=
DEMO_SECRET=
# Contraseñas de las cuentas del equipo del demo (sin la suya, el seed no crea la cuenta). Nunca en el repo.
DEMO_ADMIN_PASSWORD=
DEMO_REVIEWER_PASSWORD=
DEMO_ANALYST_PASSWORD=
# Clave secreta de prueba de Turnstile que siempre aprueba (solo desarrollo)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Opcional: contenedor ML por HTTP en local (docker run -p 8080:8080 ...). Vacío = binding de Containers.
ML_URL=
# Opcional: si existe, el contenedor exige el header x-ml-token
# ML_TOKEN=
# Opcional: Chroma Cloud para el "Motor vectorial" de la consola (solo casos ficticios del demo).
# Usa una llave limitada a la base "blindaje".
# CHROMA_API_KEY=
# CHROMA_TENANT=
