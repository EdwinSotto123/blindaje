<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cuaderno_widget_raiz"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/cuaderno_widget_fondo"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingLeft="14dp"
  android:paddingTop="8dp"
  android:paddingRight="8dp"
  android:paddingBottom="8dp">

  <TextView
    android:id="@+id/cuaderno_widget_titulo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/cuaderno_widget_nombre"
    android:textColor="@color/cuaderno_widget_lapiz"
    android:layout_marginRight="10dp"
    android:textSize="13sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/cuaderno_widget_accion"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:background="@drawable/cuaderno_widget_boton"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:paddingLeft="8dp"
      android:paddingRight="8dp"
      android:text="@string/cuaderno_widget_venta"
      android:textColor="@color/cuaderno_widget_tinta"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/cuaderno_widget_accion2"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_marginLeft="8dp"
      android:layout_weight="1"
      android:background="@drawable/cuaderno_widget_boton2"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="1"
      android:paddingLeft="8dp"
      android:paddingRight="8dp"
      android:text="@string/cuaderno_widget_fiado"
      android:textColor="@color/cuaderno_widget_tinta"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
