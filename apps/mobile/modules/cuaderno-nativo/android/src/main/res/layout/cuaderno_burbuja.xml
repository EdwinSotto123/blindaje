<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja.kt: cerrada es el ícono de Cuaderno; abierta, una tarjeta como la del widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:padding="6dp">

  <ImageView
    android:id="@+id/cuaderno_burbuja_icono"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:padding="4dp"
    android:background="@drawable/cuaderno_burbuja_circulo"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/cuaderno_burbuja_abrir" />

  <LinearLayout
    android:id="@+id/cuaderno_burbuja_tarjeta"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/cuaderno_widget_fondo"
    android:elevation="6dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/cuaderno_burbuja_titulo"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/cuaderno_widget_tinta"
      android:textSize="18sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/cuaderno_burbuja_anotar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:minHeight="48dp"
      android:gravity="center"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:background="@drawable/cuaderno_widget_boton"
      android:clickable="true"
      android:focusable="true"
      android:text="@string/cuaderno_burbuja_anotar"
      android:textColor="@color/cuaderno_widget_tinta"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/cuaderno_burbuja_grabar"
      android:textColor="@color/cuaderno_widget_lapiz"
      android:textSize="15sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="end"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/cuaderno_burbuja_minimizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/cuaderno_burbuja_minimizar"
        android:textColor="@color/cuaderno_widget_tinta"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/cuaderno_burbuja_quitar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/cuaderno_burbuja_quitar"
        android:textColor="@color/cuaderno_widget_tinta"
        android:textSize="15sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
