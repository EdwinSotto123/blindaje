---
/**
 * Resultados de la evaluación, leídos de eval/report.json en build. Cada métrica muestra su meta junto
 * al valor. Lo pendiente se ve como pendiente, con su motivo. Sin reporte, un aviso: nunca números de
 * ejemplo.
 */
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import { formatValue, readEvalReport, type EvalMetric } from "../lib/eval-report";
import { readWatermarkReport } from "../lib/watermark-report";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const r = d.results;
const report = readEvalReport();
const byId = new Map<string, EvalMetric>((report?.metrics ?? []).map((m) => [m.id, m]));
const known = new Set(r.metrics.map((m) => m.id));
const unknown = (report?.metrics ?? []).filter((m) => !known.has(m.id));
const extra = [...(report?.extra ?? []), ...unknown];
const words = { passed: r.passed, failed: r.failed };
const locale = d.lang === "es" ? "es-PE" : "en-US";
const generated = report?.generatedAt
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "America/Lima" }).format(new Date(report.generatedAt))
  : null;
/** Las notas del reporte están en español. */
const noteLang = d.lang === "es" ? undefined : "es";
const rows = r.metrics.map((m) => ({ copy: m, got: byId.get(m.id) }));
const newTab = d.lang === "es" ? " (se abre en otra pestaña)" : " (opens in a new tab)";
/** Rastreo de filtraciones: eval/results/watermark.json, tal como viene. */
const wm = readWatermarkReport();
const pct = (v: number) => `${new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(v * 100)}%`;
const LIMITS = new Set(["audio.fragmento_6s_opus_16k", "audio.opus_8k"]);
const wmGenerated = wm?.generatedAt
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "America/Lima" }).format(new Date(wm.generatedAt))
  : null;
const wmFalse =
  wm?.falseAudio && wm.falseImage
    ? r.leak.falseValue
        .replace("{a}", String(wm.falseAudio.wrong))
        .replace("{na}", String(wm.falseAudio.n))
        .replace("{i}", String(wm.falseImage.wrong))
        .replace("{ni}", String(wm.falseImage.n))
    : null;
---

<section class="section on-paper-2" id="resultados" aria-labelledby="resultados-title">
  <div class="wrap res">
    <div class="sec-head" data-reveal>
      <h2 id="resultados-title" class="head">{d.page.results.title}</h2>
      <div class="res__intro">
      <p class="lead soft">{r.lead}</p>
      {
        report && (
          <p class="small soft">
            {r.reportedNote} {generated && `${r.generatedAt} ${generated}.`}{" "}
            <a href={`${REPO_URL}/blob/main/eval/REPORT.md`} rel="noopener noreferrer" target="_blank">
              {r.fullReport}
              <span class="sr-only">{newTab}</span>
            </a>
          </p>
        )
      }
      </div>
    </div>

    <div class="res__tables">
      {
        !report && (
          <div class="res__none">
            <p class="lead">{r.placeholder}</p>
            <p class="soft">{r.pendingNote}</p>
          </div>
        )
      }

      <div class="res__main res__card">
      <table class="rt" data-reveal>
        <thead>
          <tr>
            <th scope="col">{r.cols.what}</th>
            <th scope="col" class="rt__n">{r.cols.target}</th>
            <th scope="col" class="rt__n">{r.cols.result}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ copy, got }) => {
              const value = got && !got.pending ? formatValue(got, d.lang, words) : "";
              return (
                <tr>
                  <th scope="row">
                    {copy.label}
                    {got?.note && (
                      <span class="rt__note small soft" lang={noteLang}>
                        {got.note}
                      </span>
                    )}
                  </th>
                  <td class="rt__n rt__target num soft"><span class="rt__k">{r.cols.target}: </span>{copy.target}</td>
                  <td class="rt__n num">
                    {value ? <span class="rt__value">{value}</span> : <span class="soft">{r.pending}</span>}
                    {value && got?.meets === true && (
                      <span class="rt__status">
                        <Icon name="check" />
                        {r.meets}
                      </span>
                    )}
                    {value && got?.meets === false && <span class="rt__status rt__status--miss">{r.misses}</span>}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>

      {
        extra.length > 0 && (
          <table class="rt" data-reveal>
            <caption><span class="rt__cap-title">{r.extraTitle}</span></caption>
            <tbody>
              {extra.map((m) => (
                <tr>
                  <th scope="row">
                    {m.label[d.lang] ?? m.label.es ?? m.id}
                    {m.note && (
                      <span class="rt__note small soft" lang={noteLang}>
                        {m.note}
                      </span>
                    )}
                  </th>
                  <td class="rt__n num">
                    <span class="rt__value">{m.pending ? r.pending : formatValue(m, d.lang, words)}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }

      </div>

      {
        wm && (
          <div class="res__wm res__card" id="resultados-filtracion" data-reveal>
            <table class="rt">
              <caption>
                <span class="rt__cap-title">{r.leak.title}</span>
                <span class="rt__cap-lead soft">{r.leak.lead}</span>
              </caption>
              <tbody>
                {wm.rows.map((row) => (
                  <tr class:list={[LIMITS.has(row.id) && "rt__limit"]}>
                    <th scope="row">
                      {r.leak.rows[row.id] ?? row.id}
                      {LIMITS.has(row.id) && <span class="rt__note small soft">{r.leak.limitTag}</span>}
                    </th>
                    <td class="rt__n num">
                      <span class="rt__value">{pct(row.ratio)}</span> <span class="small soft">({row.ok}/{row.n})</span>
                    </td>
                  </tr>
                ))}
                {wmFalse && (
                  <tr>
                    <th scope="row">{r.leak.falseLabel}</th>
                    <td class="rt__n rt__n--wrap num">{wmFalse}</td>
                  </tr>
                )}
              </tbody>
            </table>
            <p class="small soft">
              {wmGenerated && `${r.generatedAt} ${wmGenerated}.`}{" "}
              <a href={`${REPO_URL}/blob/main/eval/results/watermark.json`} rel="noopener noreferrer" target="_blank">
                {r.leak.source}
                <span class="sr-only">{newTab}</span>
              </a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .res__intro {
    display: grid;
    gap: 14px;
  }

  .res__intro p {
    max-width: 40em;
  }

  .res__tables {
    display: grid;
    gap: var(--gap);
    align-items: start;
  }

  .res__card {
    padding: 24px 22px;
    border-radius: var(--radius);
    background: var(--card);
  }

  .res__none {
    display: grid;
    gap: 6px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: var(--card);
  }

  .rt {
    width: 100%;
    border-collapse: collapse;
    line-height: 1.35;
  }

  .rt caption {
    caption-side: top;
    padding-bottom: 14px;
    text-align: left;
  }

  .rt__cap-title {
    display: block;
    font-size: var(--step-lead);
    font-weight: 700;
  }

  .rt__cap-lead {
    display: block;
    margin-top: 6px;
    font-size: var(--step-small);
    max-width: 40em;
  }

  .rt th,
  .rt td {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
    font-weight: 400;
  }

  .rt tr:last-child > * {
    border-bottom: 0;
  }

  .rt thead th {
    padding-top: 0;
    border-bottom: 2px solid var(--ink) !important;
    font-size: var(--step-small);
    font-weight: 700;
    color: var(--ink-2);
  }

  .rt tbody th {
    width: 100%;
    padding-right: 24px;
  }

  .rt__n {
    text-align: right !important;
    white-space: nowrap;
  }

  .rt td.rt__n + td.rt__n {
    padding-left: 24px;
  }

  .rt__n--wrap {
    white-space: normal;
    min-width: 9em;
  }

  .rt__note {
    display: block;
    margin-top: 4px;
  }

  .rt__value {
    font-size: var(--step-lead);
    font-weight: 700;
  }

  .rt__status {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: var(--step-small);
    font-weight: 700;
    color: var(--num-ink);
  }

  .rt__status--miss {
    color: var(--ink-2);
  }

  .rt__status :global(.icon) {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rt__limit .rt__value {
    color: var(--ink-2);
  }

  .rt__k {
    display: none;
  }

  .res__main {
    display: grid;
    gap: 40px;
    align-content: start;
  }

  .res__wm {
    display: grid;
    gap: 14px;
  }

  @media (max-width: 719px) {
    .rt thead {
      display: none;
    }

    .rt tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
    }

    .rt tr:last-child {
      border-bottom: 0;
    }

    .rt th,
    .rt td {
      padding: 0;
      border: 0;
    }

    .rt tbody th {
      grid-column: 1 / -1;
      padding: 0 0 6px;
    }

    .rt td.rt__n + td.rt__n {
      padding-left: 0;
    }

    .rt__target {
      text-align: left !important;
    }

    .rt__n {
      white-space: normal;
    }

    /* Una sola cifra en la fila: ocupa todo el ancho, así se alinea con la columna de resultados. */
    .rt td.rt__n:only-of-type {
      grid-column: 1 / -1;
    }

    .rt__k {
      display: inline;
    }
  }

  @media (min-width: 720px) {
    .res__card {
      padding: 32px 36px;
    }
  }

  @media (min-width: 1200px) {
    .res__tables {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .res__none {
      grid-column: 1 / -1;
    }
  }
</style>
