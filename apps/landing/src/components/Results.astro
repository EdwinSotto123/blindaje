---
/**
 * Resultados de la evaluación, leídos de eval/report.json en build. Cada métrica muestra su meta junto
 * al valor. Lo pendiente se ve como pendiente, con su motivo. Sin reporte, un aviso: nunca números de
 * ejemplo.
 */
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import { formatValue, readEvalReport, type EvalMetric } from "../lib/eval-report";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const r = d.results;
const report = readEvalReport();
const byId = new Map<string, EvalMetric>((report?.metrics ?? []).map((m) => [m.id, m]));
const known = new Set(r.metrics.map((m) => m.id));
const unknown = (report?.metrics ?? []).filter((m) => !known.has(m.id));
const extra = [...(report?.extra ?? []), ...unknown];
const words = { passed: r.passed, failed: r.failed };
const locale = d.lang === "es" ? "es-PE" : "en-US";
const generated = report?.generatedAt
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long", timeZone: "America/Lima" }).format(new Date(report.generatedAt))
  : null;
/** Las notas del reporte están en español. */
const noteLang = d.lang === "es" ? undefined : "es";
const rows = r.metrics.map((m) => ({ copy: m, got: byId.get(m.id) }));
const newTab = d.lang === "es" ? " (se abre en otra pestaña)" : " (opens in a new tab)";
---

<section class="section mist-surface" id="resultados" aria-labelledby="resultados-title">
  <div class="wrap">
    <div class="head res__head">
      <h2 id="resultados-title" class="h2">{r.title}</h2>
      <p class="lead">{r.lead}</p>
    </div>

    {
      !report && (
        <div class="res__none">
          <p class="res__none-title">{r.placeholder}</p>
          <p>{r.pendingNote}</p>
        </div>
      )
    }

    <div class="metrics__cols" aria-hidden="true">
      <span>{r.cols.what}</span>
      <span>{r.cols.target}</span>
      <span>{r.cols.result}</span>
    </div>
    <ul class="metrics" role="list">
      {
        rows.map(({ copy, got }) => {
          const value = got && !got.pending ? formatValue(got, d.lang, words) : "";
          return (
            <li class="m">
              <p class="m__what">
                <span class="m__label">{copy.label}</span>
                {got?.note && (
                  <span class="m__note" lang={noteLang}>
                    {got.note}
                  </span>
                )}
              </p>
              <p class="m__target num">
                <span class="m__k">{r.cols.target}</span>
                {copy.target}
              </p>
              <p class="m__result num">
                <span class="m__k">{r.cols.result}</span>
                {value ? (
                  <span class="m__value">{value}</span>
                ) : (
                  <span class="m__pending">{r.pending}</span>
                )}
                {value && got?.meets === true && (
                  <span class="m__status m__status--ok">
                    <Icon name="check" />
                    {r.meets}
                  </span>
                )}
                {value && got?.meets === false && <span class="m__status m__status--miss">{r.misses}</span>}
              </p>
            </li>
          );
        })
      }
    </ul>

    {
      extra.length > 0 && (
        <div class="extra">
          <h3 class="extra__title">{r.extraTitle}</h3>
          <ul class="extra__list" role="list">
            {extra.map((m) => (
              <li>
                <span class="extra__value num">{m.pending ? r.pending : formatValue(m, d.lang, words)}</span>
                <span class="extra__label">
                  {m.label[d.lang] ?? m.label.es ?? m.id}
                  {m.note && (
                    <span class="m__note num" lang={noteLang}>
                      {m.note}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      report && (
        <p class="res__date">
          {r.reportedNote} {generated && `${r.generatedAt} ${generated}.`}{" "}
          <a href={`${REPO_URL}/blob/main/eval/REPORT.md`} rel="noopener noreferrer" target="_blank">
            {r.fullReport}
            <Icon name="external" />
            <span class="sr-only">{newTab}</span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .res__none {
    display: grid;
    gap: 6px;
    margin-bottom: 32px;
    padding: 20px 22px;
    border: 1.5px dashed var(--pencil);
    border-radius: 12px;
    max-width: 52em;
  }

  .res__none-title {
    font-size: var(--fs-title);
    font-weight: 700;
  }

  .metrics__cols {
    display: none;
  }

  .metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .m {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .m__what {
    grid-column: 1 / -1;
    display: grid;
    gap: 2px;
  }

  .m__label {
    font-weight: 700;
    font-size: var(--fs-body-l);
    line-height: 1.35;
  }

  .m__note {
    display: block;
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .m__k {
    font-weight: 400;
    color: var(--pencil);
  }

  .m__k::after {
    content: ": ";
  }

  .m__target {
    color: var(--pencil);
    font-weight: 700;
  }

  .m__result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }

  .m__result .m__k {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .m__value {
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .m__pending {
    padding: 3px 12px;
    border: 1.5px dashed var(--pencil);
    border-radius: 999px;
    font-weight: 700;
  }

  .m__status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px 2px 6px;
    border-radius: 999px;
    font-size: var(--fs-caption);
    font-weight: 700;
    color: var(--ink-deep);
    white-space: nowrap;
  }

  .m__status--ok {
    background: var(--hl-mint);
  }

  .m__status--miss {
    background: var(--hl-pink);
    padding-left: 10px;
  }

  .m__status :global(.icon) {
    width: 1em;
    height: 1em;
    stroke-width: 3;
  }

  .extra {
    display: grid;
    gap: 14px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .extra__title {
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .extra__list {
    display: grid;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .extra__list li {
    display: grid;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .extra__value {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
  }

  .extra__label {
    color: var(--pencil);
  }

  .res__date {
    margin-top: 32px;
    max-width: 44em;
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .res__date a {
    color: var(--ink);
    font-weight: 700;
  }

  .res__date :global(.icon) {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-left: 3px;
    vertical-align: -0.12em;
  }

  @media (min-width: 900px) {
    .res__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }

    .m {
      grid-template-columns: minmax(0, 1fr) 9rem 16rem;
      align-items: center;
      column-gap: 32px;
    }

    .m__what {
      grid-column: 1;
    }

    .metrics__cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 9rem 16rem;
      column-gap: 32px;
      padding-bottom: 10px;
      font-size: var(--fs-small);
      font-weight: 700;
      color: var(--pencil);
    }

    .metrics__cols span:last-child {
      text-align: right;
    }

    .metrics {
      border-top-width: 2px;
    }

    .m__k {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .m__result {
      justify-content: flex-end;
      text-align: right;
    }

    .extra__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }
</style>
