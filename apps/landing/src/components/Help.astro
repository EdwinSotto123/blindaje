---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.helpSection;
---

<section class="section field-surface help-s" id="ayuda" aria-labelledby="ayuda-title">
  <div class="wrap">
    <h2 id="ayuda-title" class="h2 help-s__title">{h.title}</h2>

    <ul class="lines" role="list">
      {
        h.lines.map((l) => (
          <li class="line">
            <span class="line__num num">{l.number}</span>
            <span class="line__name">{l.name}</span>
            <a class="btn line__cta" href={`tel:${l.number}`}>
              <Icon name="phone" />
              {l.cta}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="help-s__note">{h.note}</p>
    <p class="help-s__station">{h.station}</p>
  </div>
</section>

<style>
  .help-s {
    background: var(--field-deep);
  }

  .help-s__title {
    max-width: 16ch;
  }

  .lines {
    list-style: none;
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    border-top: 2px solid var(--white);
  }

  .line {
    display: grid;
    gap: 10px;
    padding: 22px 0;
    border-bottom: 1px solid var(--field-line);
  }

  .line__num {
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--k-voice);
  }

  .line__name {
    font-size: var(--fs-body-l);
    color: var(--on-field-2);
    max-width: 30em;
  }

  .line__cta {
    justify-self: start;
    margin-top: 4px;
  }

  .help-s__note {
    margin-top: 28px;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.3;
    max-width: 30em;
  }

  .help-s__station {
    margin-top: 8px;
    color: var(--on-field-2);
  }

  @media (min-width: 900px) {
    .line {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      column-gap: 40px;
      align-items: center;
    }

    .line__cta {
      margin-top: 0;
    }
  }
</style>
