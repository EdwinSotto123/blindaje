---
/**
 * La app de la víctima por fuera y por dentro. Si existen capturas reales del celular en
 * docs/screenshots/ (nombres con cuaderno/disfraz/inicio/ventas y notas/privad/boveda), se muestran
 * esas. Si no, un diagrama rotulado como ilustración, sin marco de celular: el cuaderno de ventas
 * del disfraz escrito en tipo, la entrada secreta y, por dentro, la evidencia como nudos que se
 * amarran a la cuerda del Caso A (la misma gramática del quipu del hero).
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import type { Dict } from "../i18n";
import { findShot } from "../lib/screenshots";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const v = d.actors.victim;
const il = v.illo;
const outside = findShot("outside");
const inside = findShot("inside") ?? findShot("report");
const real = [
  outside && { image: outside.image, alt: v.shotOutsideAlt, label: il.outside },
  inside && { image: inside.image, alt: v.shotInsideAlt, label: il.inside },
].filter(Boolean) as { image: ImageMetadata; alt: string; label: string }[];
---

{
  real.length > 0 ? (
    <div class="phones">
      {real.map((s) => (
        <figure class="phones__shot">
          <Picture
            src={s.image}
            alt={s.alt}
            formats={["webp"]}
            fallbackFormat="webp"
            widths={[240, 360, 480].filter((w) => w <= s.image.width)}
            sizes="(min-width: 1000px) 240px, 42vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{s.label}</figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <figure class="dis" aria-label={il.label}>
      <div class="dis__grid">
        <div class="dis__side">
          <p class="dis__tag">{il.outside}</p>
          <div class="ledger-card">
            <p class="lc__title">{il.ledgerTitle}</p>
            <ul class="lc__rows" role="list">
              {il.ledger.map((r) => (
                <li>
                  <span class="lc__item">{r.item}</span>
                  <span class="lc__amount num">{r.amount}</span>
                </li>
              ))}
            </ul>
            <p class="lc__total">
              <span>{il.totalLabel}</span>
              <strong class="num">{il.total}</strong>
            </p>
          </div>
        </div>

        <p class="dis__key">
          <span class="dis__key-icon" aria-hidden="true">
            <Icon name="key" />
          </span>
          <span>{il.key}</span>
          <span class="dis__arrow" aria-hidden="true">
            <Icon name="arrowRight" />
          </span>
        </p>

        <div class="dis__side">
          <p class="dis__tag">{il.inside}</p>
          <div class="ev">
            <ul class="ev__knots" role="list">
              {il.evidence.map((e) => (
                <li class:list={["ev__knot", `ev__knot--${e.kind}`]}>
                  <span class="ev__glyph" aria-hidden="true">
                    {e.kind === "voice" ? (
                      <svg viewBox="0 0 18 32">
                        <rect x="2" y="1" width="14" height="30" rx="7" />
                        <path d="M4.5 9.5h9M4.5 16h9M4.5 22.5h9" />
                      </svg>
                    ) : (
                      <svg viewBox="0 0 20 20">
                        <circle cx="10" cy="10" r="8" />
                      </svg>
                    )}
                  </span>
                  <span>{e.text}</span>
                </li>
              ))}
            </ul>
            <p class="ev__found-label">{il.foundLabel}</p>
            <ul class="ev__found" role="list">
              {il.found.map((f) => (
                <li class="hl">{f}</li>
              ))}
            </ul>
            <p class="ev__case">{il.caseLabel}</p>
          </div>
        </div>
      </div>
      <figcaption class="dis__note">{il.note}</figcaption>
    </figure>
  )
}

<style>
  .phones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .phones__shot {
    display: grid;
    gap: 10px;
    width: min(240px, 42vw);
  }

  .phones__shot :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .phones__shot figcaption {
    font-size: var(--fs-small);
    font-weight: 700;
    text-align: center;
  }

  .dis {
    display: grid;
    gap: 14px;
  }

  .dis__grid {
    display: grid;
    gap: 18px;
  }

  .dis__side {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .dis__tag {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--pencil);
  }

  /* El disfraz: un cuaderno de ventas escrito, no un celular dibujado. */
  .ledger-card {
    display: grid;
    gap: 6px;
    padding: 16px 18px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--white);
  }

  .lc__title {
    font-weight: 700;
  }

  .lc__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lc__rows li,
  .lc__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-block: 6px;
    border-bottom: 1px solid var(--line);
  }

  .lc__item {
    font-family: var(--hand);
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .lc__amount,
  .lc__total strong {
    font-weight: 700;
    white-space: nowrap;
  }

  .lc__total {
    border-bottom: 0;
    padding-top: 8px;
  }

  .lc__total strong {
    font-size: var(--fs-title);
  }

  .dis__key {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .dis__key-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--hl);
  }

  .dis__arrow {
    display: none;
  }

  /* Por dentro: la evidencia es una cuerda con nudos, como en el quipu. */
  .ev {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 4px 0 0 34px;
  }

  .ev::before {
    content: "";
    position: absolute;
    left: 13px;
    top: 4px;
    bottom: 12px;
    width: 3px;
    border-radius: 4px;
    background: var(--ink);
  }

  .ev__knots {
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ev__knot {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 32px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ev__glyph {
    position: absolute;
    left: -34px;
    width: 30px;
    display: grid;
    place-items: center;
  }

  .ev__glyph svg {
    width: 18px;
    height: auto;
    overflow: visible;
  }

  .ev__glyph svg rect,
  .ev__glyph svg circle {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .ev__knot--voice rect {
    fill: var(--hl);
  }

  .ev__knot--voice path {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .ev__knot--phrase circle {
    fill: var(--hl-pink);
  }

  .ev__knot--image circle {
    fill: var(--hl-sky);
  }

  .ev__found-label {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--pencil);
    font-weight: 700;
  }

  .ev__found {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-small);
  }

  /* La cuerda termina en el caso. */
  .ev__case {
    position: relative;
    margin-top: 8px;
    font-weight: 700;
  }

  .ev__case::before {
    content: "";
    position: absolute;
    left: -28px;
    top: 50%;
    width: 14px;
    height: 14px;
    margin-top: -7px;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--mist);
  }

  .dis__note {
    font-size: var(--fs-caption);
    color: var(--pencil);
  }

  @media (min-width: 720px) {
    .dis__grid {
      grid-template-columns: minmax(0, 1.05fr) auto minmax(0, 1.1fr);
      column-gap: 18px;
      align-items: start;
    }

    .dis__key {
      flex-direction: column;
      gap: 6px;
      max-width: 6.5rem;
      margin-top: 72px;
      text-align: center;
      font-size: var(--fs-small);
    }

    .dis__arrow {
      display: block;
    }
  }
</style>
