---
/**
 * El cierre: un campo de añil donde la línea grande es la ayuda (llamar al 105, marcado con el único
 * rojo de la página, y denunciar a la Línea 1818). Arriba, notas cortas; abajo, enlaces, créditos de las fotos y el lugar.
 */
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import { CREDITS } from "../lib/photos";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const f = d.footer;
const pg = d.page.foot;
const hs = d.helpSection;
---

<footer class="foot on-field" aria-labelledby="ayuda-title">
  <div class="wrap grid foot__in">
    <div class="foot__notes small">
      <p class="foot__brand" translate="no">Blindaje</p>
      <p>{hs.note}</p>
      <p>{hs.station}</p>
      <p class="soft">{f.hackathon}</p>
    </div>
    <a class="foot__top small" href="#contenido">{pg.top}</a>

    <div class="foot__help">
      <h2 id="ayuda-title" class="sr-only">{hs.title}</h2>
      <a class="foot__call" href="tel:105">
        <span class="foot__disc" aria-hidden="true"><Icon name="phone" /></span>
        <span class="foot__call-text">{pg.callLine}</span>
      </a>
      <a class="foot__report head" href="tel:1818">{pg.reportLine}</a>
    </div>

    <div class="foot__meta small">
      <ul class="foot__links" role="list">
        <li><a href={REPO_URL} rel="noopener noreferrer">{f.repo}</a></li>
        <li>
          <a href={d.nav.switchHref} hreflang={d.nav.switchLang} lang={d.nav.switchLang}>{d.nav.switchName}</a>
        </li>
      </ul>
      <p class="foot__credits soft">
        {f.fictitious} {f.shots} {f.license} {pg.creditsLabel}:{" "}
        {
          CREDITS.map((c, i) => (
            <>
              <a href={c.url} rel="noopener noreferrer">
                {c.text}
              </a>
              {i < CREDITS.length - 1 ? "; " : "."}
            </>
          ))
        }
      </p>
      <p class="foot__place">{pg.place}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: 40px 32px;
    min-height: 80svh;
    display: flex;
  }

  .foot__in {
    row-gap: 32px;
    align-content: space-between;
  }

  .foot__notes {
    display: grid;
    gap: 6px;
    max-width: 40em;
  }

  .foot__brand {
    font-size: var(--step-lead);
    font-style: italic;
  }

  .foot__top {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot__help {
    display: grid;
    gap: 12px;
    padding-block: 64px 24px;
  }

  .foot__call {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    justify-self: start;
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .foot__call-text {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    text-underline-offset: 0.12em;
  }

  .foot__call:hover .foot__call-text {
    text-decoration-color: currentColor;
  }

  /* El 105 lleva el rojo de emergencia, el mismo de la franja de arriba. */
  .foot__disc {
    display: grid;
    place-items: center;
    width: 0.92em;
    height: 0.92em;
    border-radius: 50%;
    background: var(--alarm);
    color: #fff;
    flex: none;
  }

  .foot__disc :global(.icon) {
    width: 46%;
    height: 46%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .foot__call:hover .foot__disc {
      animation: ring 0.5s var(--ease);
    }
  }

  @keyframes ring {
    25% {
      transform: rotate(-12deg);
    }

    50% {
      transform: rotate(10deg);
    }

    75% {
      transform: rotate(-5deg);
    }
  }

  .foot__report {
    justify-self: start;
  }

  .foot__meta {
    display: grid;
    gap: 14px;
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot__credits {
    max-width: 72em;
  }

  @media (min-width: 1100px) {
    .foot__notes {
      grid-column: 1 / 8;
    }

    .foot__top {
      grid-column: 12 / 13;
      justify-self: end;
      align-self: start;
    }

    .foot__help {
      padding-top: 120px;
    }

    .foot__meta {
      grid-template-columns: 3fr 6fr 2fr;
      column-gap: var(--gap);
      align-items: start;
    }

    .foot__place {
      text-align: right;
    }
  }
</style>
