---
/**
 * El cierre: un campo de cochinilla donde la línea grande es la ayuda (llamar al 105 y denunciar a la
 * Línea 1818). Arriba, notas cortas; abajo, enlaces, créditos de las fotos y el lugar.
 */
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import { CREDITS } from "../lib/photos";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const f = d.footer;
const pg = d.page.foot;
const hs = d.helpSection;
---

<footer class="foot on-field" aria-labelledby="ayuda-title">
  <div class="wrap grid foot__in">
    <div class="foot__notes small">
      <p class="foot__brand" translate="no">Blindaje</p>
      <p>{hs.note}</p>
      <p>{hs.station}</p>
      <p class="soft">{f.hackathon}</p>
    </div>
    <a class="foot__top small" href="#contenido">{pg.top}</a>

    <div class="foot__help">
      <h2 id="ayuda-title" class="sr-only">{hs.title}</h2>
      <a class="foot__call" href="tel:105">{pg.callLine}</a>
      <a class="foot__report head" href="tel:1818">{pg.reportLine}</a>
    </div>

    <div class="foot__meta small">
      <ul class="foot__links" role="list">
        <li><a href={REPO_URL} rel="noopener noreferrer">{f.repo}</a></li>
        <li>
          <a href={d.nav.switchHref} hreflang={d.nav.switchLang} lang={d.nav.switchLang}>{d.nav.switchName}</a>
        </li>
      </ul>
      <p class="foot__credits soft">
        {f.fictitious} {f.shots} {f.license} {pg.creditsLabel}:{" "}
        {
          CREDITS.map((c, i) => (
            <>
              <a href={c.url} rel="noopener noreferrer">
                {c.text}
              </a>
              {i < CREDITS.length - 1 ? "; " : "."}
            </>
          ))
        }
      </p>
      <p class="foot__place">{pg.place}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: 40px 32px;
    min-height: 80svh;
    display: flex;
  }

  .foot__in {
    row-gap: 32px;
    align-content: space-between;
  }

  .foot__notes {
    display: grid;
    gap: 6px;
    max-width: 40em;
  }

  .foot__brand {
    font-size: var(--step-lead);
    font-style: italic;
  }

  .foot__top {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot__help {
    display: grid;
    gap: 12px;
    padding-block: 64px 24px;
  }

  .foot__call {
    font-size: clamp(2.75rem, 1.3rem + 5.6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .foot__report {
    justify-self: start;
  }

  .foot__meta {
    display: grid;
    gap: 14px;
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .foot__credits {
    max-width: 72em;
  }

  @media (min-width: 1100px) {
    .foot__notes {
      grid-column: 1 / 8;
    }

    .foot__top {
      grid-column: 12 / 13;
      justify-self: end;
      align-self: start;
    }

    .foot__help {
      padding-top: 120px;
    }

    .foot__meta {
      grid-template-columns: 3fr 6fr 2fr;
      column-gap: var(--gap);
      align-items: start;
    }

    .foot__place {
      text-align: right;
    }
  }
</style>
