---
/**
 * Lo que Blindaje hace con la evidencia, en cinco filas sobre el campo de añil. El texto va a la
 * izquierda del eje con su nota al margen (qué agente y qué modelo de Meta); a la derecha, la captura
 * real de la consola o del portal, a anchos distintos.
 */
import type { Dict } from "../i18n";
import Shot from "./Shot.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const f = d.page.features;
---

<section class="section on-field" id="inteligencia" aria-labelledby="inteligencia-title">
  <div class="wrap grid feat">
    <div class="feat__head" data-reveal>
      <h2 id="inteligencia-title" class="head">{f.title}</h2>
      <p class="lead feat__lead">{d.intel.lead}</p>
    </div>

    {
      f.rows.map((row, i) => (
        <article class:list={["row", `row--${i + 1}`]} id={i === 4 ? "filtraciones" : undefined} data-reveal>
          <div class="row__text">
            <h3 class="head row__title">{row.title}</h3>
            <p>{row.text}</p>
            <p class="small soft row__note">{row.note}</p>
          </div>
          <Shot
            name={row.shot}
            alt={row.alt}
            caption={row.caption}
            sizes={row.shot.endsWith("-movil") ? "(min-width: 1100px) 26vw, 70vw" : "(min-width: 1100px) 52vw, 92vw"}
            widths={[600, 900, 1200, 1500]}
            class="row__pic"
          />
        </article>
      ))
    }
  </div>
</section>

<style>
  .feat {
    row-gap: 96px;
  }

  .feat__head {
    display: grid;
    gap: 20px;
  }

  .feat__lead {
    max-width: 32em;
  }

  .row {
    display: grid;
    gap: 24px;
    align-items: start;
  }

  .row__text {
    display: grid;
    gap: 14px;
    max-width: 34em;
  }

  .row__title {
    font-size: var(--step-lead);
    line-height: 1.2;
  }

  .row__note {
    font-style: italic;
  }

  /* Anchos desiguales, como fotos al margen de un informe. */
  .row :global(.row__pic) {
    width: 100%;
  }

  .row--2 :global(.row__pic) {
    width: 70%;
  }

  .row--3 :global(.row__pic),
  .row--5 :global(.row__pic) {
    width: 86%;
  }

  /* En pantallas anchas cada captura se recorta desde arriba a una proporción fija: la parte que
     importa de cada pantalla está arriba y así la sección no se vuelve interminable. */
  @media (min-width: 720px) {
    .row :global(.shot__frame) {
      aspect-ratio: 16 / 10;
    }

    .row--2 :global(.shot__frame) {
      aspect-ratio: 4 / 5;
    }

    .row :global(.shot__frame img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
    }
  }

  @media (min-width: 1100px) {
    .feat {
      row-gap: 112px;
    }

    .feat__head {
      grid-column: 6 / 13;
    }

    .row {
      grid-template-columns: subgrid;
      column-gap: var(--gap);
    }

    .row__text {
      grid-column: 1 / 5;
    }

    .row :global(.row__pic) {
      grid-column: 6 / 13;
    }

    .row--2 :global(.row__pic) {
      width: 44%;
    }

    .row--3 :global(.row__pic) {
      width: 78%;
    }

    .row--5 :global(.row__pic) {
      width: 88%;
    }
  }
</style>
