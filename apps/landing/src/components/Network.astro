---
/**
 * Página de color: el quipu del gremio. A la izquierda del eje, el titular, la idea y una lámina real
 * de nudos de quipu; a la derecha, el caso ficticio de cuatro semanas que la persona puede recorrer.
 */
import type { Dict } from "../i18n";
import Photo from "./Photo.astro";
import Quipu from "./Quipu.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const q = d.page.quipu;
---

<section class="section on-field" id="red" aria-labelledby="red-title">
  <div class="wrap grid net">
    <div class="net__side" data-reveal>
      <h2 id="red-title" class="head">{q.title}</h2>
      <p class="net__lead">{q.lead}</p>
      <figure class="net__plate">
        <Photo name="lockeNudos" alt={d.page.photos.lockeNudos!.alt} sizes="(min-width: 1100px) 30vw, 80vw" widths={[480, 800, 1200]} />
        <figcaption class="cap">{q.plateCaption}</figcaption>
      </figure>
    </div>
    <div class="net__board" data-reveal>
      <Quipu dict={d} />
    </div>
  </div>
</section>

<style>
  .net {
    row-gap: 48px;
  }

  .net__side {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .net__lead {
    max-width: 30em;
  }

  .net__plate {
    max-width: 440px;
    margin-top: 12px;
  }

  .net__plate :global(img) {
    aspect-ratio: 5 / 4;
  }

  @media (min-width: 1100px) {
    .net__side {
      grid-column: 1 / 5;
    }

    .net__board {
      grid-column: 6 / 13;
    }
  }
</style>
