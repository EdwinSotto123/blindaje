---
/**
 * El problema en cifras: a la izquierda del eje, el titular y por qué las víctimas quedan solas; a la
 * derecha, una columna de cifras alineadas como en un libro contable, cada una con su fuente.
 */
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const p = d.problem;
const [soft, full] = d.page.problemTitle;
const newTab = d.lang === "es" ? " (se abre en otra pestaña)" : " (opens in a new tab)";
---

<section class="section" id="problema" aria-labelledby="problema-title">
  <div class="wrap grid prob">
    <div class="prob__side" data-reveal>
      <h2 id="problema-title" class="head">
        <span class="soft">{soft}</span>
        <span>{full}</span>
      </h2>
      <p class="prob__lead">{p.lead}</p>
      <p class="soft">
        {p.gapTitle}{" "}
        <a href={p.gapSource.url} rel="noopener noreferrer" target="_blank">
          {p.sourcePrefix} {p.gapSource.name}<span class="sr-only">{newTab}</span>
        </a>
      </p>
      <div class="prob__gaps">
        {
          p.gaps.map((g) => (
            <p>
              <strong>{g.title}.</strong> <span class="soft">{g.text}</span>
            </p>
          ))
        }
      </div>

    </div>

    <ul class="figs" role="list" data-reveal>
      {
        p.figures.map((f) => (
          <li class="fig">
            <span class="fig__value display num">{f.value}</span>
            <div class="fig__cap">
              <p>{f.text}</p>
              {f.detail && <p class="small soft">{f.detail}</p>}
              <p class="small">
                <a class="fig__src" href={f.source.url} rel="noopener noreferrer" target="_blank">
                  {p.sourcePrefix} {f.source.name}
                  <Icon name="external" />
                  <span class="sr-only">{newTab}</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .prob {
    row-gap: 56px;
  }

  .prob__side {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .prob__side h2 span {
    display: block;
  }

  .prob__lead {
    max-width: 34em;
  }

  .prob__gaps {
    display: grid;
    gap: 12px;
    max-width: 34em;
  }

  .figs {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fig {
    display: grid;
    gap: 6px;
  }

  .fig__value {
    line-height: 1;
  }

  .fig__cap {
    display: grid;
    gap: 6px;
    max-width: 30em;
  }

  .fig__src {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .fig__src :global(.icon) {
    width: 0.9em;
    height: 0.9em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* Cifras alineadas a la derecha en una sola pista, como en un libro contable; el pie va en la línea
     base de la cifra. */
  @media (min-width: 720px) {
    .figs {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: 32px;
    }

    .fig {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: baseline;
    }

    .fig__value {
      text-align: right;
    }
  }

  @media (min-width: 1100px) {
    .prob__side {
      grid-column: 1 / 6;
      position: sticky;
      top: 32px;
      align-self: start;
    }

    .figs {
      grid-column: 7 / 13;
    }
  }
</style>
