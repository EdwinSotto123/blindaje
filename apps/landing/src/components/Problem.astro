---
/**
 * El problema: el titular con su bajada, tres cifras con su fuente en una fila y, debajo, por qué hoy
 * no alcanza: evidencia débil, casos desconectados y miedo a denunciar.
 */
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const p = d.problem;
const [first, second] = d.page.problemTitle;
const newTab = d.lang === "es" ? " (se abre en otra pestaña)" : " (opens in a new tab)";
---

<section class="section" id="problema" aria-labelledby="problema-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="problema-title" class="head">{first} {second}</h2>
      <p class="lead soft">{p.lead}</p>
    </div>

    <ul class="figs" role="list" data-reveal>
      {
        p.figures.slice(0, 3).map((f) => (
          <li class="fig">
            <span class="fig__value num">{f.value}</span>
            <p class="fig__text">{f.text}</p>
            <a class="fig__src small" href={f.source.url} rel="noopener noreferrer" target="_blank">
              {p.sourcePrefix} {f.source.name}
              <Icon name="external" />
              <span class="sr-only">{newTab}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="gaps" data-reveal>
      <h3 class="gaps__title">{d.lp.problem.gapsTitle}</h3>
      <ul class="gaps__list" role="list">
        {
          p.gaps.map((g) => (
            <li>
              <p>
                <strong>{g.title}.</strong> <span class="soft">{g.text}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="gaps__note small soft">
        {p.gapTitle}{" "}
        <a href={p.gapSource.url} rel="noopener noreferrer" target="_blank">
          {p.sourcePrefix} {p.gapSource.name}<span class="sr-only">{newTab}</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .figs {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fig {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }

  .fig__value {
    font-family: var(--display);
    font-size: clamp(2.5rem, 1.8rem + 2.4vw, 3.5rem);
    font-weight: 700;
    font-variation-settings: "opsz" 96;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fig__text {
    max-width: 26em;
  }

  .fig__src {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--ink-2);
  }

  .fig__src :global(.icon) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gaps {
    display: grid;
    gap: 24px;
    margin-top: 56px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--paper-2);
  }

  .gaps__title {
    font-size: var(--step-lead);
  }

  .gaps__list {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
    }

    .gaps {
      padding: 36px 40px;
    }

    .gaps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
</style>
