---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const p = d.problem;
---

<section class="section problem" id="problema" aria-labelledby="problema-title">
  <div class="wrap">
    <div class="head problem__head">
      <h2 id="problema-title" class="h2">{p.title}</h2>
      <p class="lead">{p.lead}</p>
    </div>

    <ul class="ledger" role="list">
      {
        p.figures.map((f) => (
          <li class="ledger__row">
            <p class="ledger__value num">{f.value}</p>
            <div class="ledger__text">
              <p class="ledger__main">{f.text}</p>
              {f.detail && <p class="ledger__detail">{f.detail}</p>}
              <p class="ledger__source">
                {p.sourcePrefix}{" "}
                <a href={f.source.url} rel="noopener noreferrer">
                  {f.source.name}
                  <Icon name="external" />
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="gaps">
      <p class="gaps__title">
        {p.gapTitle}{" "}
        <a class="gaps__src" href={p.gapSource.url} rel="noopener noreferrer">
          {p.sourcePrefix} {p.gapSource.name}
          <Icon name="external" />
        </a>
      </p>
      <ul class="gaps__list" role="list">
        {
          p.gaps.map((g) => (
            <li>
              <h3 class="gaps__name">{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .ledger__row {
    display: grid;
    gap: 10px;
    padding-block: 26px;
    border-bottom: 1px solid var(--line);
  }

  .ledger__value {
    font-size: clamp(2.75rem, 1.4rem + 4.4vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ledger__text {
    display: grid;
    gap: 8px;
    max-width: 40em;
    padding-top: 0.35em;
  }

  .ledger__main {
    font-size: var(--fs-body-l);
    line-height: 1.45;
    font-weight: 700;
  }

  .ledger__detail {
    color: var(--pencil);
  }

  .ledger__source {
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .ledger__source a,
  .gaps__src {
    color: var(--ink);
    font-weight: 700;
  }

  .ledger__source :global(.icon),
  .gaps__src :global(.icon) {
    display: inline-block;
    vertical-align: -0.15em;
    width: 0.95em;
    height: 0.95em;
    margin-left: 4px;
  }

  .gaps {
    display: grid;
    gap: 32px;
    margin-top: clamp(56px, 7vw, 96px);
  }

  .gaps__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.012em;
    max-width: 30em;
  }

  .gaps__src {
    display: inline-block;
    font-size: var(--fs-small);
    letter-spacing: 0;
    margin-top: 6px;
  }

  .gaps__list {
    display: grid;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gaps__list li {
    display: grid;
    gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }

  .gaps__name {
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .gaps__list p {
    color: var(--pencil);
  }

  @media (min-width: 900px) {
    .problem__head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 64px;
      align-items: end;
    }

    .ledger__row {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 48px;
      align-items: start;
      padding-block: 36px;
    }

    .gaps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
</style>
