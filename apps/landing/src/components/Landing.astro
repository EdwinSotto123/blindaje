---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Problem from "./Problem.astro";
import Signals from "./Signals.astro";
import Benefits from "./Benefits.astro";
import How from "./How.astro";
import Tour from "./Tour.astro";
import Tech from "./Tech.astro";
import Commitments from "./Commitments.astro";
import Results from "./Results.astro";
import Faq from "./Faq.astro";
import PilotForm from "./PilotForm.astro";
import Footer from "./Footer.astro";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Base dict={dict} path={lang === "es" ? "/" : "/en/"}>
  <Header dict={dict} />
  <main id="contenido" tabindex="-1">
    <Hero dict={dict} />
    <Problem dict={dict} />
    <Signals dict={dict} />
    <Benefits dict={dict} />
    <How dict={dict} />
    <Tour dict={dict} />
    <Tech dict={dict} />
    <Commitments dict={dict} />
    <Results dict={dict} />
    <Faq dict={dict} />
    <PilotForm dict={dict} />
  </main>
  <Footer dict={dict} />
</Base>

<style>
  main:focus,
  main :global([tabindex="-1"]:focus) {
    outline: none;
  }
</style>
