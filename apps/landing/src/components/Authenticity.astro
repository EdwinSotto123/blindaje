---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const a = d.authenticity;
---

<section class="section authn" id="autenticidad" aria-labelledby="authn-title">
  <div class="wrap">
    <div class="head authn__head">
      <h2 id="authn-title" class="h2">{a.title}</h2>
      <p class="lead">{a.lead}</p>
    </div>

    <div class="authn__grid">
      <div class="authn__text">
        <h3 class="authn__sub">{a.checksTitle}</h3>
        <ul class="checks" role="list">
          {
            a.checks.map((c) => (
              <li>
                <span class="checks__name">{c.name}</span>
                <span class="checks__text">{c.text}</span>
                <span class="checks__by mono">{c.by}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="authn__sub">{a.verdictsTitle}</h3>
        <ul class="verdicts" role="list">
          {
            a.verdicts.map((v) => (
              <li>
                <Icon name="check" />
                <span>
                  <strong>{v.title}</strong> {v.text}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="authn__absence">
          <Icon name="alert" />
          <span>{a.absence}</span>
        </p>
      </div>

      <Shot
        name="consola-autenticidad-evidencia"
        alt={a.shot.alt}
        caption={a.shot.caption}
        sizes="(min-width: 1240px) 640px, (min-width: 1000px) 52vw, 92vw"
        widths={[400, 600, 800, 1100, 1488]}
        class="authn__shot"
      />
    </div>
  </div>
</section>

<style>
  .authn__grid {
    display: grid;
    gap: 48px;
  }

  .authn__text {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .authn__sub {
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .authn__sub:not(:first-child) {
    margin-top: 24px;
  }

  .checks,
  .verdicts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .checks {
    border-top: 2px solid var(--ink);
  }

  .checks li {
    display: grid;
    gap: 4px 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .checks__name {
    font-weight: 700;
  }

  .checks__text {
    color: var(--pencil);
  }

  .checks__by {
    justify-self: start;
    max-width: 11rem;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--mist);
    color: var(--ink-deep);
    font-weight: 700;
    line-height: 1.35;
  }

  @media (min-width: 600px) {
    .checks li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .checks__text {
      grid-column: 1;
    }

    .checks__by {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      justify-self: end;
      text-align: right;
    }
  }

  .verdicts {
    display: grid;
    gap: 12px;
  }

  .verdicts li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .verdicts :global(.icon) {
    margin-top: 3px;
    padding: 2px;
    border-radius: 50%;
    background: var(--hl-mint);
  }

  .authn__absence {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--hl-pink);
    color: var(--ink-deep);
    font-weight: 700;
  }

  .authn__absence :global(.icon) {
    margin-top: 2px;
  }

  @media (min-width: 900px) {
    .authn__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }
  }

  @media (min-width: 1000px) {
    .authn__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
  }
</style>
