---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const a = d.authenticity;
const l = a.leak;
/**
 * Marcas ficticias de 16 bits (AudioSeal), separadas entre sí por al menos 5 bits como en la API.
 * La copia filtrada es la de la segunda cuenta con un bit dañado ("?"): igual apunta a una sola.
 */
const tags = ["1011001011000101", "0110110100111000", "1100011110100110"].map((t) => [...t]);
const match = 1;
const leaked = [..."011011?100111000"];
---

<section class="section authn" id="autenticidad" aria-labelledby="authn-title">
  <div class="wrap">
    <div class="head authn__head">
      <h2 id="authn-title" class="h2">{a.title}</h2>
      <p class="lead">{a.lead}</p>
    </div>

    <div class="authn__grid">
      <div class="authn__text">
        <h3 class="authn__sub">{a.checksTitle}</h3>
        <ul class="checks" role="list">
          {
            a.checks.map((c) => (
              <li>
                <span class="checks__name">{c.name}</span>
                <span class="checks__text">{c.text}</span>
                <span class="checks__by mono">{c.by}</span>
              </li>
            ))
          }
        </ul>

        <h3 class="authn__sub">{a.verdictsTitle}</h3>
        <ul class="verdicts" role="list">
          {
            a.verdicts.map((v) => (
              <li>
                <Icon name="check" />
                <span>
                  <strong>{v.title}</strong> {v.text}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="authn__absence">
          <Icon name="alert" />
          <span>{a.absence}</span>
        </p>
      </div>

      <Shot
        name="consola-autenticidad-evidencia"
        alt={a.shot.alt}
        caption={a.shot.caption}
        sizes="(min-width: 1240px) 640px, (min-width: 1000px) 52vw, 92vw"
        widths={[400, 600, 800, 1100, 1488]}
        class="authn__shot"
      />
    </div>

    <div class="leak" id="filtraciones">
      <div class="head leak__head">
        <h3 class="leak__title">{l.title}</h3>
        <p class="lead">{l.lead}</p>
      </div>

      <div class="authn__grid">
        <div class="authn__text">
          <dl class="leak__points">
            {
              l.points.map((p) => (
                <div>
                  <dt>{p.title}</dt>
                  <dd>{p.text}</dd>
                </div>
              ))
            }
          </dl>

          <figure class="bits">
            <figcaption class="bits__label">{l.figure.label}</figcaption>
            <ul class="bits__rows" role="list">
              {
                tags.map((t, i) => (
                  <li class:list={["bits__row", i === match && "bits__row--match"]}>
                    <span class="bits__who">{l.figure.accounts[i]}</span>
                    <span class="bits__cells" aria-hidden="true">
                      {t.map((b) => (
                        <span class:list={["bit", b === "1" && "bit--on"]} />
                      ))}
                    </span>
                  </li>
                ))
              }
              <li class="bits__row bits__row--leak">
                <span class="bits__who">{l.figure.leaked}</span>
                <span class="bits__cells" aria-hidden="true">
                  {leaked.map((b) => (
                    <span class:list={["bit", b === "1" && "bit--on", b === "?" && "bit--damaged"]} />
                  ))}
                </span>
              </li>
            </ul>
            <p class="bits__match">{l.figure.match}</p>
            <p class="bits__note">{l.figure.note}</p>
          </figure>

          <p class="leak__prod">
            <Icon name="check" />
            <span>{l.prod}</span>
          </p>
          <p>
            {l.measured} <a href="#resultados-filtracion">{l.measuredLink}</a>.
          </p>
          <p class="authn__absence">
            <Icon name="alert" />
            <span>{l.limit}</span>
          </p>
        </div>

        <Shot
          name="consola-rastreo-filtracion"
          alt={l.shot.alt}
          caption={l.shot.caption}
          sizes="(min-width: 1240px) 640px, (min-width: 1000px) 52vw, 92vw"
          widths={[400, 600, 800, 1100, 1480]}
          class="authn__shot"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .authn__grid {
    display: grid;
    gap: 48px;
  }

  .authn__text {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .authn__sub {
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .authn__sub:not(:first-child) {
    margin-top: 24px;
  }

  .checks,
  .verdicts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .checks {
    border-top: 2px solid var(--ink);
  }

  .checks li {
    display: grid;
    gap: 4px 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .checks__name {
    font-weight: 700;
  }

  .checks__text {
    color: var(--pencil);
  }

  .checks__by {
    justify-self: start;
    max-width: 11rem;
    padding: 3px 8px;
    border-radius: 8px;
    background: var(--mist);
    color: var(--ink-deep);
    font-weight: 700;
    line-height: 1.35;
  }

  /* Rastreo de filtraciones: las mismas marcas de Meta, al revés. */
  .leak {
    margin-top: clamp(64px, 8vw, 112px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 2px solid var(--ink);
  }

  .leak__title {
    font-size: clamp(1.75rem, 1.15rem + 2.1vw, 2.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.022em;
    max-width: 20ch;
  }

  .leak__points {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .leak__points div {
    display: grid;
    gap: 2px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .leak__points dt {
    font-weight: 700;
  }

  .leak__points dd {
    margin: 0;
    color: var(--pencil);
  }

  /* Las marcas como bits: 1 en tinta, 0 en blanco, el bit dañado en rosado punteado. */
  .bits {
    --cell: 11px;
    display: grid;
    gap: 10px;
    margin: 8px 0 4px;
    padding: 18px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--mist);
  }

  .bits__label {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--pencil);
  }

  .bits__rows {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bits__row {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) auto;
    align-items: center;
    gap: 10px;
    padding: 4px 6px;
    border-radius: 8px;
    font-size: var(--fs-small);
  }

  .bits__row--match {
    background: var(--hl);
    font-weight: 700;
  }

  .bits__row--leak {
    margin-top: 6px;
    border: 1.5px dashed var(--ink);
    font-weight: 700;
  }

  .bits__cells {
    display: grid;
    grid-template-columns: repeat(16, var(--cell));
    column-gap: 2px;
  }

  /* Separación entre grupos de 4 bits. */
  .bits__cells .bit:nth-child(4n + 1):not(:first-child) {
    margin-left: 4px;
  }

  .bit {
    height: calc(var(--cell) * 1.45);
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    background: var(--white);
  }

  .bit--on {
    background: var(--ink);
  }

  .bit--damaged {
    border-style: dashed;
    background: var(--hl-pink);
  }

  .bits__match {
    font-weight: 700;
  }

  .bits__note {
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .leak__prod {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--hl-mint);
    color: var(--ink-deep);
    font-weight: 700;
  }

  .leak__prod :global(.icon) {
    margin-top: 2px;
  }

  @media (min-width: 720px) {
    .bits {
      --cell: 14px;
    }

    .bits__row {
      grid-template-columns: 7.5rem auto;
    }
  }

  @media (min-width: 600px) {
    .checks li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .checks__text {
      grid-column: 1;
    }

    .checks__by {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      justify-self: end;
      text-align: right;
    }
  }

  .verdicts {
    display: grid;
    gap: 12px;
  }

  .verdicts li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .verdicts :global(.icon) {
    margin-top: 3px;
    padding: 2px;
    border-radius: 50%;
    background: var(--hl-mint);
  }

  .authn__absence {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--hl-pink);
    color: var(--ink-deep);
    font-weight: 700;
  }

  .authn__absence :global(.icon) {
    margin-top: 2px;
  }

  @media (min-width: 900px) {
    .leak__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }

    .authn__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }
  }

  @media (min-width: 1000px) {
    .authn__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
  }
</style>
