---
/**
 * Recorrido del producto: seis funciones con su captura real de la consola. Con JavaScript es un
 * grupo de pestañas (flechas, Inicio y Fin); sin JavaScript se ven todas, una debajo de otra.
 */
import type { Dict } from "../i18n";
import Shot from "./Shot.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const t = d.lp.tour;

/**
 * Notas a mano sobre las capturas, en las coordenadas del marco (1488 × 1083: la captura a ese ancho,
 * recortada arriba). Texto en % del marco; trazos de la flecha en unidades del marco.
 */
const PENS: Partial<Record<string, { x: number; y: number; d: string[] }>> = {
  "consola-vinculo-misma-voz": { x: 53, y: 15.6, d: ["M780 192 C 752 192, 728 194, 700 195", "M717 183 L 699 195 L 717 207"] },
  "consola-red-grafo": { x: 51, y: 13.2, d: ["M1004 196 C 1046 270, 1046 400, 1012 476", "M997 456 L 1011 479 L 1027 461"] },
  "consola-autenticidad-evidencia": { x: 47, y: 30.8, d: ["M692 357 C 664 357, 640 355, 614 353", "M631 341 L 613 353 L 631 366"] },
  "consola-rastreo-filtracion": { x: 28.4, y: 75.4, d: ["M412 838 C 380 842, 340 846, 302 846", "M319 834 L 301 846 L 319 858"] },
};
---

<section class="section" id="producto" aria-labelledby="producto-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="producto-title" class="head">{t.title}</h2>
      <p class="lead soft">{t.lead}</p>
    </div>

    <div class="tour" data-tour>
      <div class="tour__tabs" role="tablist" aria-label={t.tabsLabel}>
        {
          t.items.map((it, i) => (
            <button
              type="button"
              class="tour__tab"
              role="tab"
              id={`tour-tab-${i}`}
              aria-controls={`tour-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {it.tab}
            </button>
          ))
        }
      </div>

      {
        t.items.map((it, i) => (
          <div
            class:list={["tour__panel", i === 0 && "is-active"]}
            role="tabpanel"
            id={`tour-panel-${i}`}
            aria-labelledby={`tour-tab-${i}`}
            tabindex="0"
          >
            <div class="tour__text">
              <h3 class="tour__title">{it.title}</h3>
              <p class="soft">{it.text}</p>
              <span class="tag">{it.note}</span>
            </div>
            <Shot
              name={it.shot}
              alt={it.alt}
              caption={it.caption}
              sizes="(min-width: 1100px) 780px, (min-width: 720px) 90vw, 92vw"
              widths={[640, 960, 1280, 1488]}
              class="tour__shot"
            >
              {it.pen && PENS[it.shot] && (
                <div class="pen" aria-hidden="true">
                  <svg viewBox="0 0 1488 1083" focusable="false">
                    {PENS[it.shot]!.d.map((p) => (
                      <path d={p} pathLength="1" />
                    ))}
                  </svg>
                  <p style={`left:${PENS[it.shot]!.x}%;top:${PENS[it.shot]!.y}%`}>{it.pen}</p>
                </div>
              )}
            </Shot>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tour {
    display: grid;
    gap: 32px;
  }

  .tour__tabs {
    display: none;
  }

  .tour__panel {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  /* Sin JavaScript, los paneles se apilan con aire entre ellos. */
  .tour__panel + .tour__panel {
    margin-top: 56px;
  }

  .tour__text {
    display: grid;
    gap: 14px;
    justify-items: start;
    align-content: start;
  }

  .tour__title {
    font-size: var(--step-lead);
    line-height: 1.25;
  }

  .tour__text p {
    max-width: 36em;
  }

  .tour :global(.tour__shot .shot__frame) {
    border-radius: var(--radius);
    box-shadow: var(--lift);
  }

  /* La nota a mano de la portada, sobre cada captura: solo con el marco fijo de pantallas anchas. */
  .pen {
    display: none;
  }

  @media (min-width: 960px) {
    .pen {
      display: block;
      position: absolute;
      inset: 0;
      container-type: inline-size;
      pointer-events: none;
    }

    .pen svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .pen path {
      fill: none;
      stroke: var(--pen);
      stroke-width: 6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .pen p {
      position: absolute;
      color: var(--pen);
      font-family: var(--hand);
      font-weight: 700;
      font-size: clamp(0.875rem, 2.7cqi, 1.3125rem);
      line-height: 1;
      white-space: nowrap;
      transform: rotate(-3deg);
      transform-origin: left center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tour__panel.is-active .pen p {
      animation: pen-ink 0.6s ease-out 0.35s both;
    }

    .tour__panel.is-active .pen path {
      stroke-dasharray: 1;
      animation: pen-draw 0.5s ease-out 0.8s both;
    }

    .tour__panel.is-active .pen path + path {
      animation-delay: 1.25s;
      animation-duration: 0.25s;
    }
  }

  @keyframes pen-ink {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes pen-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* ---------- Con JavaScript: pestañas ---------- */

  :global(.js) .tour__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tour__tab {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-2);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .tour__tab:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .tour__tab[aria-selected="true"] {
    border-color: var(--field);
    background: var(--field);
    color: var(--on-field);
  }

  .tour__tab:focus-visible {
    outline: 3px solid var(--field);
    outline-offset: 2px;
  }

  :global(.js) .tour__panel {
    display: none;
  }

  :global(.js) .tour__panel + .tour__panel {
    margin-top: 0;
  }

  :global(.js) .tour__panel.is-active {
    display: grid;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tour__panel.is-active {
      animation: panel-in 0.5s var(--ease) both;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(3px);
    }
  }

  @media (min-width: 960px) {
    .tour__panel {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 56px;
    }

    .tour__text {
      padding-top: 24px;
    }

    /* En pantallas anchas todas las capturas comparten marco: cambiar de pestaña no mueve la página. */
    .tour :global(.tour__shot .shot__frame) {
      aspect-ratio: 1488 / 1083;
    }

    .tour :global(.tour__shot img) {
      height: 100%;
      object-fit: cover;
      object-position: top;
    }
  }
</style>

<script>
  for (const tour of document.querySelectorAll<HTMLElement>("[data-tour]")) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") ?? ""));
    const select = (i: number, focus: boolean) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j]?.classList.toggle("is-active", on);
      });
      if (focus) {
        tabs[i]?.focus();
        tabs[i]?.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i, false));
      t.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : e.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : e.key === "Home" ? 0
          : e.key === "End" ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
</script>
