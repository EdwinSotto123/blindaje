---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const a = d.authority;
---

<section class="section band" id="autoridad" aria-labelledby="autoridad-title">
  <div class="wrap authority">
    <div class="authority__text">
      <h2 id="autoridad-title">
        <span class="mlabel">{a.label}<span class="sr-only">. </span></span>
        <span class="h2">{a.title}</span>
      </h2>
      <p class="lead">{a.lead}</p>
      <p class="authority__channel">{a.channel}</p>
    </div>

    <div class="dossier sheet">
      <h3 class="dossier__title">
        <Icon name="file" />
        {a.dossierTitle}
      </h3>
      <p class="dossier__example">{a.example}</p>
      <ol class="dossier__list" role="list">
        {
          a.dossier.map((r, i) => (
            <li>
              <span class="dossier__n num" aria-hidden="true">{i + 1}</span>
              <span>
                <span class="dossier__item">{r.title}</span>
                <span class="dossier__text">{r.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .authority {
    display: grid;
    gap: 40px;
  }

  .authority__text {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .authority__channel {
    max-width: 33em;
    color: var(--pencil);
  }

  .dossier {
    padding: 20px 18px 8px;
  }

  .dossier__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-title);
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }

  .dossier__example {
    padding: 12px 0 4px;
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .dossier__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dossier__list li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .dossier__list li:last-child {
    border-bottom: 0;
  }

  .dossier__n {
    flex-shrink: 0;
    width: 1.5ch;
    font-family: var(--hand);
    font-weight: 700;
    font-size: var(--fs-title);
    line-height: 1.1;
  }

  .dossier__item {
    display: block;
    font-weight: 700;
    font-size: var(--fs-body);
  }

  .dossier__text {
    display: block;
    color: var(--pencil);
  }

  @media (min-width: 720px) {
    .dossier {
      padding: 26px 30px 10px;
    }
  }

  @media (min-width: 1024px) {
    .authority {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(40px, 5vw, 80px);
      align-items: start;
    }
  }
</style>
