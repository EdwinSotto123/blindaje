---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
  /** Fuera de la portada (por ejemplo en la 404), las anclas llevan a la portada. */
  onHome?: boolean;
}

const { dict: d, onHome = true } = Astro.props;
const home = d.lang === "es" ? "/" : "/en/";
const prefix = onHome ? "" : home;
const links = [
  { href: `${prefix}#como-funciona`, label: d.nav.how },
  { href: `${prefix}#inteligencia`, label: d.nav.intelligence },
  { href: `${prefix}#tecnologia`, label: d.nav.tech },
  { href: `${prefix}#resultados`, label: d.nav.results },
];
/** Página neutra para "Salir rápido": reemplaza esta entrada del historial. */
const exitUrl = "https://www.google.com/";
---

<div class="help" role="region" aria-label={d.help.ariaLabel}>
  <div class="wrap help__in">
    <a class="help__exit" href={exitUrl} rel="noreferrer" aria-describedby="exit-hint" data-quick-exit>
      <Icon name="exit" />
      <span class="wide">{d.help.exit}</span>
      <span class="narrow" aria-hidden="true">{d.help.exitShort}</span>
    </a>
    <span class="sr-only" id="exit-hint">{d.help.exitHint}</span>
    <p class="help__item">
      <span class="help__lead">{d.help.danger}</span>
      <a class="pill" href="tel:105">
        <Icon name="phone" />
        {d.help.dangerCta}
      </a>
    </p>
    <p class="help__item">
      <span class="help__lead">{d.help.report}</span>
      <a class="pill" href="tel:1818">{d.help.reportCta}</a>
    </p>
  </div>
</div>

<header class="top field-surface">
  <div class="wrap top__in">
    <a class="brand" href={home} translate="no">Blindaje</a>
    <nav class="nav" aria-label={d.nav.ariaLabel}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="top__pilot" href={`${prefix}#piloto`}>{d.nav.pilot}</a>
    <a class="lang" href={d.nav.switchHref} hreflang={d.nav.switchLang} lang={d.nav.switchLang}>
      <span class="lang__long">{d.nav.switchName}</span>
      <span class="lang__short" aria-hidden="true">{d.nav.switchShort}</span>
    </a>
  </div>
</header>

<style>
  .help {
    background: var(--field-deep);
    color: var(--on-field-2);
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .help__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    padding-block: 6px;
  }

  .help__item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .help__lead,
  .help :global(.icon) {
    display: none;
  }

  /* En móvil se ve "Salir"; el nombre accesible sigue siendo "Salir rápido". */
  .wide {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .pill,
  .help__exit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill {
    background: var(--white);
    color: var(--ink-deep);
  }

  .pill:hover {
    background: var(--k-voice);
  }

  /* Primera en el orden de foco, a la derecha en pantalla. */
  .help__exit {
    order: 3;
    margin-left: auto;
    border: 2px solid var(--white);
    color: var(--white);
  }

  .help__exit:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .help a:focus-visible,
  .top a:focus-visible {
    outline-color: var(--k-voice);
  }

  .top__in {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 72px;
  }

  .brand {
    margin-right: auto;
    font-family: var(--hand);
    font-weight: 700;
    font-size: 1.875rem;
    line-height: 1;
    text-decoration: none;
    padding-top: 0.14em;
    color: var(--white);
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a,
  .lang,
  .top__pilot {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    color: var(--white);
  }

  .nav a {
    color: var(--on-field-2);
  }

  .nav a:hover {
    color: var(--white);
    background: rgb(255 255 255 / 0.08);
  }

  .top__pilot {
    background: var(--white);
    color: var(--ink-deep);
    white-space: nowrap;
  }

  .top__pilot:hover {
    background: var(--k-voice);
  }

  .lang {
    border: 2px solid rgb(255 255 255 / 0.55);
  }

  .lang:hover {
    border-color: var(--white);
    background: rgb(255 255 255 / 0.08);
  }

  /* En móvil se ve "EN"/"ES"; el nombre accesible sigue siendo el idioma completo. */
  .lang__long {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 379px) {
    .top__pilot {
      padding: 0 10px;
    }

    .brand {
      font-size: 1.625rem;
    }
  }

  @media (min-width: 720px) {
    .wide {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .help :global(.icon) {
      display: block;
    }

    .narrow {
      display: none;
    }

    .help__in {
      column-gap: 20px;
    }

    .lang__long {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .lang__short {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .help__lead {
      display: inline;
    }
  }

  @media (min-width: 1100px) {
    .nav {
      display: block;
      margin-right: 12px;
    }

    .top__in {
      min-height: 80px;
    }
  }
</style>

<script>
  // Salir rápido: abre una pestaña neutra y reemplaza esta página en el historial. Atajo: Esc dos
  // veces seguidas. Las anclas internas no agregan entradas al historial, así "volver atrás" no
  // regresa a Blindaje después de salir.
  const exit = document.querySelector<HTMLAnchorElement>("[data-quick-exit]");
  function quickExit() {
    if (!exit) return;
    window.open(exit.href, "_blank", "noopener,noreferrer");
    window.location.replace(exit.href);
  }
  exit?.addEventListener("click", (e) => {
    e.preventDefault();
    quickExit();
  });
  let lastEsc = 0;
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const now = Date.now();
    if (now - lastEsc < 800) quickExit();
    lastEsc = now;
  });

  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="#"]');
    if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const id = decodeURIComponent(link.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!target) return;
    e.preventDefault();
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
    target.focus({ preventScroll: true });
    history.replaceState(null, "", `#${id}`);
  });
</script>
