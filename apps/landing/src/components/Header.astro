---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const home = d.lang === "es" ? "/" : "/en/";
const links = [
  { href: "#victima", label: d.nav.how },
  { href: "#compromisos", label: d.nav.commitments },
  { href: "#piloto", label: d.nav.pilot },
  { href: "#tecnologia", label: d.nav.tech },
  { href: "#resultados", label: d.nav.results },
];
/** Página neutra para "Salir rápido": reemplaza esta entrada del historial. */
const exitUrl = "https://www.google.com/";
---

<div class="help" role="region" aria-label={d.help.ariaLabel}>
  <div class="wrap help__in">
    <p class="help__item">
      <span class="help__lead">{d.help.danger}</span>
      <a class="pill" href="tel:105">
        <Icon name="phone" />
        {d.help.dangerCta}
      </a>
    </p>
    <p class="help__item">
      <span class="help__lead">{d.help.report}</span>
      <a class="pill" href="tel:1818">{d.help.reportCta}</a>
    </p>
    <a class="help__exit" href={exitUrl} rel="noreferrer" aria-label={d.help.exitLabel} data-quick-exit>
      <Icon name="exit" />
      <span class="wide">{d.help.exit}</span>
      <span class="narrow" aria-hidden="true">{d.help.exitShort}</span>
    </a>
  </div>
</div>

<header class="top">
  <div class="wrap top__in">
    <a class="brand" href={home}>Blindaje</a>
    <nav class="nav" aria-label={d.nav.ariaLabel}>
      <ul>
        {
          links.map((l) => (
            <li class:list={[l.href !== "#piloto" && "nav__wide"]}>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={d.nav.switchHref} hreflang={d.nav.switchLang} lang={d.nav.switchLang} aria-label={d.nav.switchLabel}>
      <span class="lang__long">{d.nav.switchName}</span>
      <span class="lang__short" aria-hidden="true">{d.nav.switchShort}</span>
    </a>
  </div>
</header>

<style>
  .help {
    position: relative;
    z-index: 1;
    background: var(--ink);
    color: #fff;
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .help__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    padding-block: 8px;
  }

  .help__item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .help__lead,
  .wide,
  .help :global(.icon) {
    display: none;
  }

  .pill,
  .help__exit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 11px;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill {
    background: #fff;
    color: var(--ink);
  }

  .pill:hover {
    background: var(--hl);
    color: var(--ink);
  }

  .help__exit {
    margin-left: auto;
    border: 2px solid #fff;
    color: #fff;
  }

  .help__exit:hover {
    background: var(--ink-deep);
    color: #fff;
  }

  .help a:focus-visible {
    outline-color: var(--hl);
  }

  .top__in {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 72px;
  }

  .brand {
    margin-right: auto;
    font-family: var(--hand);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
    padding-top: 0.12em;
  }

  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__wide {
    display: none;
  }

  .nav a,
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    font-weight: 700;
    font-size: var(--fs-body);
    text-decoration: none;
  }

  .nav a:hover {
    background: var(--grid-fill);
  }

  .lang {
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .lang:hover {
    background: var(--grid-fill);
  }

  .lang__long {
    display: none;
  }

  @media (min-width: 720px) {
    .help__lead,
    .wide {
      display: inline;
    }

    .help :global(.icon) {
      display: block;
    }

    .narrow {
      display: none;
    }

    .help__in {
      column-gap: 24px;
    }

    .lang__long {
      display: inline;
    }

    .lang__short {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .nav__wide {
      display: list-item;
    }
  }
</style>

<script>
  // Salir rápido: reemplaza esta página en el historial por una neutra, sin dejar "volver atrás".
  document.querySelectorAll<HTMLAnchorElement>("[data-quick-exit]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      window.location.replace(a.href);
    });
  });
</script>
