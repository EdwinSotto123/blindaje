---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
  /** Fuera de la portada (por ejemplo en la 404), las anclas llevan a la portada. */
  onHome?: boolean;
}

const { dict: d, onHome = true } = Astro.props;
const home = d.lang === "es" ? "/" : "/en/";
const prefix = onHome ? "" : home;
const links = [
  { href: `${prefix}#como-funciona`, label: d.nav.how },
  { href: `${prefix}#inteligencia`, label: d.nav.intelligence },
  { href: `${prefix}#tecnologia`, label: d.nav.tech },
  { href: `${prefix}#resultados`, label: d.nav.results },
];
/** Página neutra para "Salir rápido": reemplaza esta entrada del historial. */
const exitUrl = "https://www.google.com/";
---

<div class="help on-field" role="region" aria-label={d.help.ariaLabel}>
  <div class="wrap help__in">
    <p class="help__item">
      <span class="help__lead">{d.help.danger}</span>
      <a class="help__call" href="tel:105">
        <Icon name="phone" />
        {d.help.dangerCta}
      </a>
    </p>
    <p class="help__item">
      <span class="help__lead">{d.help.report}</span>
      <a class="help__call" href="tel:1818">{d.help.reportCta}</a>
    </p>
    <a class="help__exit" href={exitUrl} rel="noreferrer" aria-describedby="exit-hint" data-quick-exit>
      <Icon name="exit" />
      <span class="wide">{d.help.exit}</span>
      <span class="narrow" aria-hidden="true">{d.help.exitShort}</span>
    </a>
    <span class="sr-only" id="exit-hint">{d.help.exitHint}</span>
  </div>
</div>

<header class="top">
  <div class="wrap top__in">
    <a class="brand" href={home} translate="no">Blindaje</a>
    <nav class="nav" aria-label={d.nav.ariaLabel}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={d.nav.switchHref} hreflang={d.nav.switchLang} lang={d.nav.switchLang}>
      <span class="lang__long">{d.nav.switchName}</span>
      <span class="lang__short" aria-hidden="true">{d.nav.switchShort}</span>
    </a>
    <a class="btn top__pilot" href={`${prefix}#piloto`}>{d.nav.pilot}</a>
  </div>
</header>

<style>
  .help {
    font-size: var(--step-small);
    line-height: 1.3;
  }

  .help__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
  }

  .help__item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .help__lead {
    display: none;
    color: var(--on-field-2);
  }

  .help__call,
  .help__exit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 500;
    white-space: nowrap;
  }

  .help__call {
    text-decoration-thickness: 1px;
  }

  .help :global(.icon) {
    display: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Primera en el orden visual de la derecha; en móvil se ve "Salir", el nombre accesible sigue completo. */
  .help__exit {
    margin-left: auto;
    padding: 0 14px;
    background: var(--on-field);
    color: var(--field);
    text-decoration: none;
  }

  .help__exit:hover {
    background: #fff;
  }

  .wide {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: solo lectores de pantalla */
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .top__in {
    display: flex;
    align-items: center;
    gap: 8px 20px;
    min-height: 72px;
  }

  .brand {
    margin-right: auto;
    font-size: var(--step-lead);
    font-style: italic;
    line-height: 1;
    text-decoration: none;
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a,
  .lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .nav a:hover,
  .lang:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .top__pilot {
    min-height: 44px;
    padding: 0 16px;
    font-size: var(--step-small);
  }

  .lang__long {
    position: absolute;
    width: 1px;
    height: 1px; /* taste-skill-ignore: solo lectores de pantalla */
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 720px) {
    .wide,
    .lang__long {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .narrow,
    .lang__short {
      display: none;
    }

    .help :global(.icon) {
      display: block;
    }

    .top__pilot {
      padding: 0 20px;
      font-size: var(--step-body);
    }
  }

  @media (min-width: 1024px) {
    .help__lead {
      display: inline;
    }
  }

  @media (min-width: 1100px) {
    .nav {
      display: block;
    }

    .top__in {
      min-height: 84px;
    }
  }
</style>

<script>
  // Salir rápido: abre una pestaña neutra y reemplaza esta página en el historial. Atajo: Esc dos
  // veces seguidas. Las anclas internas no agregan entradas al historial, así "volver atrás" no
  // regresa a Blindaje después de salir.
  const exit = document.querySelector<HTMLAnchorElement>("[data-quick-exit]");
  function quickExit() {
    if (!exit) return;
    window.open(exit.href, "_blank", "noopener,noreferrer");
    window.location.replace(exit.href);
  }
  exit?.addEventListener("click", (e) => {
    e.preventDefault();
    quickExit();
  });
  let lastEsc = 0;
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const now = Date.now();
    if (now - lastEsc < 800) quickExit();
    lastEsc = now;
  });

  document.addEventListener("click", (e) => {
    const link = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a[href^="#"]');
    if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const id = decodeURIComponent(link.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!target) return;
    e.preventDefault();
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
    target.focus({ preventScroll: true });
    history.replaceState(null, "", `#${id}`);
  });
</script>
