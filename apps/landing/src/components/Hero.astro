---
/**
 * La portada, sobre añil: el título y la acción a la izquierda; a la derecha, el quipu del gremio que
 * se amarra solo (HeroQuipu). Debajo, una banda de fotos sin separación (quipus de museo que se funden,
 * una calle con mototaxis, la cifra del problema en algodón y el Mercado Central).
 */
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import type { PhotoKey } from "../lib/photos";
import HeroQuipu from "./HeroQuipu.astro";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.hero;
const pg = d.page;
const khipus: PhotoKey[] = ["khipuEspiral", "khipuCleveland", "khipuColgante"];
const mainSizes = "(min-width: 1100px) 50vw, (min-width: 720px) 66vw, 100vw";
/** "No cambiaron de voz." → la palabra "voz" va en el ocre de la voz, como su nudo. */
const voiceAt = h.title[1].lastIndexOf(h.voiceWord);
const line2 =
  voiceAt < 0
    ? [h.title[1], "", ""]
    : [h.title[1].slice(0, voiceAt), h.voiceWord, h.title[1].slice(voiceAt + h.voiceWord.length)];
---

<section class="mast on-field" aria-labelledby="mast-title">
  <div class="wrap grid mast__body">
    <div class="mast__text">
      <h1 id="mast-title" class="display mast__title">
        <span>{h.title[0]}</span>{" "}
        <span>{line2[0]}<em class="mast__voz">{line2[1]}</em>{line2[2]}</span>
      </h1>
      <p class="lead mast__lead">{h.lead}</p>
      <div class="mast__actions">
        <a class="btn btn--paper" href="#piloto">
          {h.ctaPilot}
          <Icon name="arrowRight" />
        </a>
        <a class="link-arrow" href="#como-funciona">
          {pg.mast.howCta}
          <Icon name="arrowDown" />
        </a>
      </div>
      <p class="mast__note small soft">
        {h.serves} <a href={REPO_URL} rel="noopener noreferrer">{h.repo}</a>
      </p>
    </div>
    <div class="mast__fig">
      <HeroQuipu dict={d} />
    </div>
  </div>

  <div class="band">
    <div class="cell cell--main" data-crossfade>
      <figure class="layer is-on">
        <Photo name={khipus[0]!} alt={pg.photos[khipus[0]!]!.alt} sizes={mainSizes} />
        <figcaption class="layer__cap">{pg.photos[khipus[0]!]!.caption}</figcaption>
      </figure>
      {/* Las otras capas llegan después de la carga para no competir con la primera imagen. */}
      <template data-more-layers>
        {
          khipus.slice(1).map((k) => (
            <figure class="layer" aria-hidden="true">
              <Photo name={k} alt="" sizes={mainSizes} />
              <figcaption class="layer__cap">{pg.photos[k]!.caption}</figcaption>
            </figure>
          ))
        }
      </template>
    </div>
    <figure class="cell cell--street">
      <Photo name="mototaxisPiura" alt={pg.photos.mototaxisPiura!.alt} sizes="(min-width: 1100px) 25vw, 34vw" widths={[400, 600, 900]} />
    </figure>
    <p class="cell cell--fact">
      <span class="fact__value num">{pg.mast.fact}</span>
      <span class="fact__text">{pg.mast.factText}</span>
    </p>
    <figure class="cell cell--market">
      <Photo name="mercado" alt={pg.photos.mercado!.alt} sizes="25vw" widths={[400, 600, 900]} />
    </figure>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1fr;
    height: clamp(240px, 36svh, 420px);
  }

  .cell {
    position: relative;
    margin: 0;
    overflow: hidden;
    min-height: 0;
  }

  .cell--street,
  .cell--fact,
  .cell--market {
    display: none;
  }

  .layer {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .layer.is-on {
    opacity: 1;
  }

  .layer :global(img) {
    transform: scale(1.001);
    transition: transform 9s linear;
  }

  .layer.is-on :global(img) {
    transform: scale(1.045);
  }

  /* Velo neutro solo bajo el pie de foto. */
  .layer__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px var(--margin) 12px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0)); /* taste-skill-ignore: velo neutro bajo el pie de foto */
    color: #fff;
    font-size: var(--step-small);
    line-height: 1.35;
  }

  .cell--market :global(img) {
    object-position: center 80%;
  }

  /* En el celular la foto va sola: el pie (y su crédito en el pie de página) queda para pantallas anchas. */
  @media (max-width: 719px) {
    .layer__cap {
      display: none;
    }
  }

  .cell--fact {
    background: var(--paper);
    color: var(--ink);
  }

  .fact__value {
    font-size: var(--step-head);
    line-height: 1;
  }

  .fact__text {
    font-size: var(--step-small);
    line-height: 1.35;
    color: var(--ink-2);
    max-width: 18em;
  }

  .mast__body {
    padding-block: 40px 56px;
    row-gap: 40px;
    align-items: center;
  }

  .mast__text {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .mast__title {
    font-style: italic;
  }

  .mast__title span {
    display: block;
  }

  /* La palabra "voz" en el ocre de su nudo; subrayada a mano por un trazo que se dibuja una vez. */
  .mast__voz {
    position: relative;
    color: var(--voz);
    font-style: inherit;
  }

  .mast__voz::after {
    content: "";
    position: absolute;
    left: 0.04em;
    right: 0.02em;
    bottom: 0.02em;
    height: 0.06em;
    min-height: 2px;
    background: currentColor;
    transform-origin: left;
  }

  .mast__lead {
    max-width: 30em;
  }

  .mast__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 6px;
  }

  .mast__note {
    max-width: 34em;
  }

  .mast__fig {
    display: grid;
    justify-items: center;
  }

  /* Entrada del título: la línea 1 y luego la 2; el subrayado de "voz" llega cuando el quipu amarra
     la voz. Todo parte visible si no hay animación. */
  @media (prefers-reduced-motion: no-preference) {
    .mast__title span,
    .mast__lead,
    .mast__actions,
    .mast__note {
      animation: mast-in 0.8s var(--ease) both;
    }

    .mast__title span:nth-child(2) {
      animation-delay: 0.12s;
    }

    .mast__lead {
      animation-delay: 0.24s;
    }

    .mast__actions {
      animation-delay: 0.34s;
    }

    .mast__note {
      animation-delay: 0.44s;
    }

    .mast__voz::after {
      animation: mast-underline 0.7s var(--ease) 2.9s both;
    }
  }

  @keyframes mast-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }
  }

  @keyframes mast-underline {
    from {
      transform: scaleX(0);
    }
  }

  @media (min-width: 720px) {
    .band {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: 1fr 1fr;
      height: clamp(300px, 42svh, 480px);
    }

    .cell--main {
      grid-row: 1 / 3;
    }

    .cell--fact {
      display: grid;
      align-content: end;
      gap: 8px;
      padding: 20px 24px;
    }

    .cell--street {
      display: block;
    }
  }

  @media (min-width: 1100px) {
    .band {
      grid-template-columns: 6fr 3fr 3fr;
    }

    .cell--street {
      grid-row: 1 / 3;
    }

    .cell--market {
      display: block;
    }

    .mast__body {
      padding-block: 56px 72px;
    }

    .mast__text {
      grid-column: 1 / 7;
    }

    .mast__fig {
      grid-column: 7 / 13;
      justify-items: end;
    }
  }
</style>

<script>
  // Fundido lento entre los quipus: 1.6 s de fundido y unos 7 s quietos. Las capas 2 y 3 se agregan
  // cuando la página terminó de cargar. Se pausa con la pestaña oculta y no corre con movimiento
  // reducido (entonces queda solo la primera).
  const box = document.querySelector<HTMLElement>("[data-crossfade]");
  const tpl = box?.querySelector<HTMLTemplateElement>("template[data-more-layers]");
  if (box && tpl && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const begin = () => {
      box.append(tpl.content.cloneNode(true));
      const layers = [...box.querySelectorAll<HTMLElement>(".layer")];
      let i = 0;
      let timer = 0;
      const next = () => {
        const n = (i + 1) % layers.length;
        const img = layers[n]!.querySelector("img");
        // Si la siguiente todavía no llegó, se espera a la próxima vuelta.
        if (img && !img.complete) return;
        layers[i]!.classList.remove("is-on");
        layers[n]!.classList.add("is-on");
        i = n;
      };
      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(next, 7000);
      };
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) window.clearInterval(timer);
        else start();
      });
      start();
    };
    if (document.readyState === "complete") begin();
    else window.addEventListener("load", begin, { once: true });
  }
</script>
