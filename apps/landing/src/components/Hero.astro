---
/**
 * Portada: a la izquierda qué es Blindaje, para quién y qué hacer; a la derecha el producto de verdad.
 * La consola (el grafo de la red R-001) en una ventana, el portal de negocios en un celular encima y
 * una nota a mano que señala la voz compartida, como se anota un cuaderno. "Voz" se marca con el
 * resaltador de la consola. Debajo, la fila de lo que se usó de Meta.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import { productShot } from "../lib/screenshots";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.lp.hero;
const [line1, line2] = d.hero.title;
const word = d.hero.voiceWord;
const at = line2.toLowerCase().indexOf(word.toLowerCase());
const before = at >= 0 ? line2.slice(0, at) : line2;
const marked = at >= 0 ? line2.slice(at, at + word.length) : "";
const after = at >= 0 ? line2.slice(at + word.length) : "";

const graph = productShot("consola-red-grafo");
const portal = productShot("portal-negocios-panorama-movil");
const graphImg = graph
  ? await getImage({ src: graph, widths: [560, 840, 1120, 1480].filter((w) => w <= graph.width), format: "webp", quality: 80 })
  : null;
const portalImg = portal
  ? await getImage({ src: portal, widths: [240, 360, 480].filter((w) => w <= portal.width), format: "webp", quality: 80 })
  : null;
---

<section class="hero on-field" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="display hero__title">
        <span class="hero__line">{line1}</span>{" "}
        <span class="hero__line">{before}{marked && <mark class="hero__mark">{marked}</mark>}{after}</span>
      </h1>
      <p class="lead hero__lead">{h.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--mark" href="#piloto">
          {d.hero.ctaPilot}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--ghost" href="#como-funciona">{d.hero.ctaHow}</a>
      </div>
      <ul class="checks hero__points" role="list">
        {
          h.points.map((p) => (
            <li>
              <Icon name="check" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      graph && graphImg && (
        <figure class="hero__stage" aria-label={h.stageLabel}>
          <div class="stage__frame">
          <div class="win">
            <div class="win__bar">
              <span class="win__brand" aria-hidden="true" translate="no">
                Blindaje
              </span>
              <span class="win__title">{h.consoleTitle}</span>
              <span class="win__pill">{h.simulated}</span>
            </div>
            <div class="win__body">
              <img
                src={graphImg.src}
                srcset={graphImg.srcSet.attribute}
                sizes="(min-width: 1100px) 680px, (min-width: 720px) 86vw, 92vw"
                width={graph.width}
                height={graph.height}
                alt={h.consoleAlt}
                fetchpriority="high"
                decoding="async"
              />
              <svg class="note-pen" viewBox="0 0 1480 1180" aria-hidden="true" focusable="false">
                <path d="M700 196 C 640 196, 602 226, 589 280" pathLength="1" />
                <path d="M606 262 L 588 284 L 578 257" pathLength="1" />
              </svg>
              <p class="note-hand" aria-hidden="true">{h.annotation}</p>
            </div>
          </div>
          {
            portal && portalImg && (
              <div class="phone">
                <img
                  src={portalImg.src}
                  srcset={portalImg.srcSet.attribute}
                  sizes="220px"
                  width={portal.width}
                  height={portal.height}
                  alt={h.phoneAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )
          }
          </div>
          <figcaption class="hero__cap">{h.note}</figcaption>
        </figure>
      )
    }
  </div>

  <div class="built">
    <div class="wrap built__in">
      <p class="built__label">{d.lp.built.label}</p>
      <ul class="built__list" role="list">
        {d.lp.built.items.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 40px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding-bottom: 64px;
  }

  /* En una columna el texto se reparte: titular, frase y botones; luego el producto; luego los vistos. */
  .hero__copy {
    display: contents;
  }

  .hero__title,
  .hero__lead,
  .hero__cta {
    order: 1;
  }

  .hero__stage {
    order: 2;
    margin-top: 16px;
  }

  .hero__points {
    order: 3;
    margin-top: 8px;
  }

  /* El titular siempre en dos líneas: en el celular mide el ancho de la pantalla; en dos columnas
     crece con su columna. */
  .hero__title {
    font-size: max(1.75rem, calc(8.9vw - 0.25rem));
  }

  @media (min-width: 600px) {
    .hero__title {
      font-size: clamp(2.25rem, 1.2rem + 3.6vw, 3.25rem);
    }
  }

  .hero__line {
    display: block;
  }

  /* El resaltador de la consola: la tinta pasa sobre "voz" y el texto se vuelve oscuro. */
  .hero__mark {
    padding: 0 0.12em;
    margin: 0 -0.04em;
    border-radius: 0.12em;
    background: linear-gradient(var(--mark), var(--mark)) no-repeat left 55% / 100% 86%;
    color: var(--ink);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__lead {
    max-width: 34em;
    color: var(--on-field-2);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .hero__points {
    font-weight: 700;
  }

  /* ---------- El producto ---------- */

  .hero__stage {
    margin-inline: 0;
    margin-bottom: 0;
  }

  .stage__frame {
    position: relative;
  }

  .win {
    overflow: hidden;
    border-radius: var(--radius);
    background: #fbfcfe;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6);
  }

  .win__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 6px 16px;
    background: #fff;
    border-bottom: 1px solid #dce6f2;
    color: var(--pen);
    font-size: var(--step-small);
    font-weight: 700;
  }

  .win__brand {
    font-family: var(--hand);
    font-size: var(--step-lead);
    line-height: 1;
    padding-top: 3px;
  }

  .win__title {
    min-width: 0;
    color: #4a5b7a;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .win__pill {
    margin-left: auto;
    padding: 2px 10px;
    border-radius: 999px;
    background: #ffe066;
    color: var(--pen);
    white-space: nowrap;
  }

  .win__body {
    position: relative;
    container-type: inline-size;
  }

  .win__body img {
    width: 100%;
  }

  /* La nota a mano, en tinta de bolígrafo, a la derecha de la voz V-3 del grafo. La flecha se dibuja
     en las coordenadas de la captura (1480 × 1180), así apunta al nodo a cualquier ancho. */
  .note-pen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .note-pen path {
    fill: none;
    stroke: var(--pen);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .note-hand {
    position: absolute;
    left: 48.5%;
    top: 12.4%;
    color: var(--pen);
    font-family: var(--hand);
    font-weight: 700;
    font-size: clamp(0.875rem, 3.1cqi, 1.3125rem);
    line-height: 1;
    white-space: nowrap;
    transform: rotate(-3deg);
    transform-origin: left center;
    pointer-events: none;
  }

  .phone {
    display: none;
  }

  .hero__cap {
    margin-top: 14px;
    font-size: var(--step-small);
    color: var(--on-field-2);
  }

  /* El celular se apoya sobre el borde izquierdo de la consola sin tapar los casos del grafo. */
  @media (min-width: 560px) {
    .stage__frame {
      padding-left: 112px;
      padding-bottom: 28px;
    }

    .phone {
      display: block;
      position: absolute;
      left: 0;
      bottom: 0;
      width: 176px;
      aspect-ratio: 9 / 17;
      padding: 7px;
      border-radius: 30px;
      border: 1px solid rgb(245 247 251 / 0.16);
      background: var(--field-deep);
      box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.7);
    }

    .phone img {
      width: 100%;
      height: 100%;
      border-radius: 23px;
      object-fit: cover;
      object-position: top;
    }

    .hero__cap {
      padding-left: 200px;
    }
  }

  /* ---------- Hecho con Meta AI ---------- */

  .built {
    background: var(--field-deep);
  }

  .built__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
    padding-block: 22px;
  }

  .built__label {
    font-size: var(--step-small);
    color: var(--on-field-2);
  }

  .built__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
    color: var(--on-field);
  }

  @media (min-width: 1100px) {
    .hero {
      padding-top: 56px;
    }

    .hero__title {
      font-size: min(3.625rem, calc(4.46vw - 0.4rem));
    }

    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: center;
      gap: 48px;
      padding-bottom: 88px;
    }

    .hero__copy {
      display: grid;
      gap: 24px;
      align-content: center;
    }

    .hero__stage {
      margin-top: 0;
    }

    .hero__points {
      margin-top: 8px;
    }
  }

  /* ---------- Movimiento ----------
     Por defecto todo está en su estado final. Con movimiento permitido: el texto sube, la consola
     llega, el celular se apoya encima, el resaltador pasa sobre "voz" y la nota se escribe. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * {
      animation: hero-in 0.8s var(--ease) both;
    }

    .hero__copy > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .hero__copy > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .hero__copy > :nth-child(4) {
      animation-delay: 0.24s;
    }

    .hero__mark {
      animation: mark-sweep 0.7s var(--ease) 0.55s both;
    }

    .win {
      animation: stage-in 1s var(--ease) 0.15s both;
    }

    .phone {
      animation: phone-in 0.9s var(--ease) 0.5s both;
    }

    .note-hand {
      animation: ink 0.6s ease-out 1.05s both;
    }

    .note-pen path {
      stroke-dasharray: 1;
      animation: pen 0.55s ease-out 1.55s both;
    }

    .note-pen path + path {
      animation-delay: 2.05s;
      animation-duration: 0.25s;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
  }

  @keyframes mark-sweep {
    from {
      background-size: 0% 86%;
      color: var(--on-field);
    }
  }

  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(32px) scale(0.98);
    }
  }

  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }

  @keyframes pen {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes ink {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
