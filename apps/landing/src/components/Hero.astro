---
import type { Dict } from "../i18n";
import { REPO_URL } from "../i18n/sources";
import Icon from "./Icon.astro";
import Quipu from "./Quipu.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.hero;
const [first, second] = h.title;
/** "No cambiaron de voz." → la palabra de la voz va en el amarillo de los nudos de voz. */
const at = second.toLowerCase().lastIndexOf(h.voiceWord.toLowerCase());
const secondParts =
  at >= 0 ? [second.slice(0, at), second.slice(at, at + h.voiceWord.length), second.slice(at + h.voiceWord.length)] : [second, "", ""];
---

<section class="hero field-surface" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__l1">{first}</span>{" "}
      <span class="hero__l2">{secondParts[0]}<span class="hero__voice">{secondParts[1]}</span>{secondParts[2]}</span>
    </h1>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__lead">{h.lead}</p>
        <div class="hero__ctas">
          <a class="btn" href="#piloto">
            {h.ctaPilot}
            <Icon name="arrowRight" />
          </a>
          <a class="btn btn--ghost" href="#como-funciona">{h.ctaHow}</a>
        </div>
        <p class="hero__serves">{h.serves}</p>
        <a class="hero__repo" href={REPO_URL} rel="noopener noreferrer">
          {h.repo}
          <Icon name="external" />
        </a>
      </div>

      <div class="hero__demo">
        <h2 class="hero__demo-title">{h.demo.label}</h2>
        <Quipu dict={d} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(28px, 4vw, 52px) clamp(64px, 8vw, 112px);
  }

  .hero__title {
    display: grid;
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.032em;
    max-width: 15ch;
  }

  .hero__l1 {
    color: var(--on-field-2);
  }

  .hero__l2 {
    color: var(--white);
  }

  .hero__voice {
    color: var(--k-voice);
  }

  .hero__grid {
    display: grid;
    gap: 48px;
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  .hero__copy {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .hero__lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--on-field-2);
    max-width: 32em;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__serves {
    padding-top: 18px;
    border-top: 1px solid var(--field-line);
    color: var(--on-field-2);
    font-size: var(--fs-small);
    max-width: 30em;
  }

  .hero__repo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    color: var(--white);
  }

  .hero__repo :global(.icon) {
    width: 1.05em;
    height: 1.05em;
  }

  .hero__demo {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .hero__demo-title {
    font-size: var(--fs-body-l);
    font-weight: 700;
    line-height: 1.3;
    color: var(--white);
  }

  @media (max-width: 479px) {
    .hero__ctas .btn {
      width: 100%;
    }
  }

  @media (min-width: 1000px) {
    .hero__title {
      max-width: none;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(40px, 5vw, 88px);
    }

    .hero__copy {
      padding-top: 38px;
    }
  }
</style>
