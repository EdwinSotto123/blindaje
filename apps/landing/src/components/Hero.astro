---
/**
 * Portada: la Lima de verdad y el producto trabajando para ella. A la izquierda, una foto de calle
 * (mototaxis en el centro de Lima, con licencia y crédito) con el portal público real en un celular
 * encima; a la derecha, el titular, la frase de valor, las dos acciones y a quién protege. Debajo, la
 * fila de lo que se usó de Meta. El único movimiento: la foto se abre y el celular sube, una vez.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import { productShot } from "../lib/screenshots";
import { PORTAL_URL } from "../i18n/sources";
import Icon from "./Icon.astro";
import calle from "../assets/fotos/mototaxis-calle.jpg";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.lp.hero;

const photo = await getImage({ src: calle, widths: [480, 720, 960, 1200], format: "webp", quality: 78 });
const portal = productShot("portal-zona-movil");
const portalImg = portal
  ? await getImage({ src: portal, widths: [240, 360, 480].filter((w) => w <= portal.width), format: "webp", quality: 80 })
  : null;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="display hero__title">{h.title}</h1>
      <p class="lead hero__lead">{h.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--mark" href={`${PORTAL_URL}/mapa`}>
          {h.ctaMap}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--ghost" href="#como-funciona">{d.hero.ctaHow}</a>
      </div>
      <p class="hero__for">
        <span class="hero__for-label">{h.audienceLabel}</span>
        {
          h.audience.map((a) => (
            <span class="hero__who">{a}</span>
          ))
        }
      </p>
    </div>

    <figure class="hero__stage">
      <div class="foto hero__photo">
        <img
          src={photo.src}
          srcset={photo.srcSet.attribute}
          sizes="(min-width: 1100px) 640px, 92vw"
          width={calle.width}
          height={calle.height}
          alt={h.photoAlt}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      {
        portal && portalImg && (
          <div class="phone">
            <img
              src={portalImg.src}
              srcset={portalImg.srcSet.attribute}
              sizes="210px"
              width={portal.width}
              height={portal.height}
              alt={h.phoneAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
      <figcaption class="hero__cap">
        <span>{h.photoCredit}</span>
        <span>{h.phoneCap}</span>
      </figcaption>
    </figure>
  </div>

  <div class="built">
    <div class="wrap built__in">
      <p class="built__label">{d.lp.built.label}</p>
      <ul class="built__list" role="list">
        {d.lp.built.items.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 40px;
    background: var(--crema);
  }

  .hero__grid {
    display: grid;
    gap: 40px;
    padding-bottom: 56px;
  }

  .hero__copy {
    display: grid;
    gap: 22px;
    align-content: center;
  }

  .hero__title {
    max-width: 12ch;
  }

  .hero__lead {
    max-width: 33em;
    color: var(--tinta-2);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  /* A quién protege: una línea de palabras con un punto de ladrillo, no una lista con vistos. */
  .hero__for {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin-top: 6px;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
    color: var(--tinta-2);
    font-weight: 700;
  }

  .hero__for-label {
    color: var(--tinta-3);
    font-weight: 400;
  }

  .hero__who {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tinta);
  }

  .hero__who::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--terracota);
  }

  /* La foto y el celular. El celular cuelga del borde de la foto, abajo a la derecha. */
  .hero__stage {
    position: relative;
    margin: 0;
    padding-bottom: 64px;
  }

  .hero__photo {
    aspect-ratio: 4 / 3;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 60%;
  }

  .phone {
    position: absolute;
    right: 12px;
    bottom: 0;
    width: clamp(132px, 34vw, 210px);
    padding: 7px;
    border-radius: 30px;
    background: var(--noche);
    box-shadow:
      0 2px 4px rgb(42 30 23 / 0.2),
      0 30px 50px -20px rgb(42 30 23 / 0.55);
  }

  .phone img {
    width: 100%;
    border-radius: 23px;
  }

  .hero__cap {
    display: grid;
    gap: 2px;
    max-width: calc(100% - clamp(150px, 38vw, 240px));
    margin-top: 12px;
    color: var(--tinta-3);
    font-size: var(--step-small);
    line-height: 1.4;
  }

  /* Hecho con Meta AI: una franja hundida, en la misma tinta, sin logos. */
  .built {
    background: var(--crema-2);
    border-block: 1px solid var(--linea);
  }

  .built__in {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
    padding-block: 18px;
  }

  .built__label {
    color: var(--tinta-2);
    font-size: var(--step-small);
  }

  .built__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @media (min-width: 720px) {
    .hero {
      padding-top: 56px;
    }

    .hero__photo {
      aspect-ratio: 16 / 10;
    }

    .phone {
      right: 28px;
    }
  }

  @media (min-width: 1100px) {
    .hero {
      padding-top: 64px;
    }

    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 64px;
      padding-bottom: 72px;
    }

    /* En pantallas anchas la foto va a la izquierda, como en la vista previa elegida. */
    .hero__stage {
      order: -1;
    }

    .hero__photo {
      aspect-ratio: 5 / 4;
    }

    .phone {
      right: -36px;
      width: 200px;
    }

    .hero__title {
      font-size: clamp(3.25rem, 1.3rem + 3vw, 4.5rem);
    }
  }

  /* El único momento de movimiento: la foto se abre desde el centro y el celular sube. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__photo {
      animation: open-photo 1.1s var(--ease) both;
    }

    .phone {
      animation: phone-up 0.9s var(--ease) 0.45s both;
    }
  }

  @keyframes open-photo {
    from {
      clip-path: inset(6% 8% round var(--r-foto));
    }

    to {
      clip-path: inset(0 round var(--r-foto));
    }
  }

  @keyframes phone-up {
    from {
      opacity: 0;
      transform: translateY(28px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
