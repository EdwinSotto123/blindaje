---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const c = d.commitments;
---

<section class="section" id="compromisos" aria-labelledby="compromisos-title">
  <div class="wrap">
    <h2 id="compromisos-title">
      <span class="mlabel">{c.label}<span class="sr-only">. </span></span>
      <span class="h2">{c.title}</span>
    </h2>
    <p class="lead commit__lead">{c.lead}</p>

    <ul class="nots" role="list">
      {
        c.items.map((it) => (
          <li class="not">
            <span class="not__title">{it.title}</span>
            {it.text && <span class="not__text">{it.text}</span>}
          </li>
        ))
      }
    </ul>

    <div class="honest sheet">
      <h3 class="honest__title">
        <Icon name="lock" />
        {c.honestyTitle}
      </h3>
      <p>{c.honesty}</p>
      <p class="honest__legal">
        {c.legal}{" "}
        <a href={c.legalLink.url} rel="noopener" target="_blank">
          {c.legalLink.name}
          <span class="sr-only">{d.lang === "es" ? "(se abre en otra pestaña)" : "(opens in a new tab)"}</span>
        </a>.
      </p>
    </div>
  </div>
</section>

<style>
  .commit__lead {
    margin-top: 24px;
  }

  .nots {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    display: grid;
  }

  .not {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .not__title {
    font-weight: 700;
    font-size: var(--fs-body-l);
    line-height: 1.35;
  }

  .not__text {
    color: var(--pencil);
    max-width: 52ch;
  }

  .honest {
    display: grid;
    gap: 12px;
    margin-top: 44px;
    padding: 22px;
    max-width: 820px;
  }

  .honest__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-title);
  }

  .honest p {
    max-width: 68ch;
  }

  .honest__legal {
    color: var(--pencil);
  }

  .honest__legal a {
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .nots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }

    .honest {
      padding: 28px 32px;
    }
  }
</style>
