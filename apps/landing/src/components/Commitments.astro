---
/**
 * Lo que Blindaje no hace: ocho límites en dos columnas, cada uno con su razón, y la nota honesta sobre
 * el cifrado y la revisión legal.
 */
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const c = d.commitments;
---

<section class="section" id="limites" aria-labelledby="limites-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="limites-title" class="head">{d.lp.trust.title}</h2>
      <p class="lead soft">{d.lp.trust.lead}</p>
    </div>

    <ul class="lim" role="list" data-reveal>
      {
        c.items.map((it) => (
          <li class="lim__item">
            <span class="lim__icon">
              <Icon name="x" />
            </span>
            <p>
              <strong>{it.title}</strong>
              {it.text && <span class="soft"> {it.text}</span>}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="lim__honest" data-reveal>
      <Icon name="shield" />
      <div>
        <p class="lim__honest-title">{c.honestyTitle}.</p>
        <p>{c.honesty}</p>
        <p class="small soft">
          {c.legal} <a href={c.legalLink.url} rel="noopener noreferrer">{c.legalLink.name}</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .lim {
    display: grid;
    gap: 0 var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lim__item {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }

  .lim__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--ink);
  }

  .lim__icon :global(.icon),
  .lim__honest > :global(.icon) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lim__item p {
    padding-top: 3px;
  }

  .lim__honest {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    margin-top: 48px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--field);
    color: var(--on-field);
  }

  .lim__honest > :global(.icon) {
    width: 28px;
    height: 28px;
    stroke: var(--ocre);
    stroke-width: 2;
  }

  .lim__honest > div {
    display: grid;
    gap: 10px;
    max-width: 35em;
  }

  .lim__honest .soft {
    color: var(--on-field-2);
  }

  .lim__honest a {
    color: var(--on-field);
  }

  .lim__honest-title {
    font-size: var(--step-lead);
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .lim {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
    }
  }
</style>
