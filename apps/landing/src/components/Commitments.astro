---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const c = d.commitments;
const newTab = d.lang === "es" ? " (se abre en otra pestaña)" : " (opens in a new tab)";
---

<section class="section" id="compromisos" aria-labelledby="compromisos-title">
  <div class="wrap">
    <div class="head commit__head">
      <h2 id="compromisos-title" class="h2">{c.title}</h2>
      <p class="lead muted">{c.lead}</p>
    </div>

    <ul class="nots" role="list">
      {
        c.items.map((it) => (
          <li class="not">
            <Icon name="x" />
            <span>
              <strong class="not__title">{it.title}</strong>
              {it.text && <span class="not__text">{it.text}</span>}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="plain">
      <h3 class="plain__title">
        <Icon name="lock" />
        {c.honestyTitle}
      </h3>
      <p>{c.honesty}</p>
      <p class="plain__legal">
        {c.legal}{" "}
        <a href={c.legalLink.url} rel="noopener noreferrer" target="_blank">
          {c.legalLink.name}
          <Icon name="external" />
          <span class="sr-only">{newTab}</span>
        </a>.
      </p>
    </div>
  </div>
</section>

<style>
  .nots {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .not {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .not > :global(.icon) {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    padding: 4px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--hl-pink);
    stroke-width: 2.5;
  }

  .not__title {
    display: block;
    font-size: var(--fs-body-l);
    line-height: 1.35;
  }

  .not__text {
    display: block;
    margin-top: 2px;
    color: var(--pencil);
  }

  .plain {
    display: grid;
    gap: 10px;
    margin-top: clamp(40px, 5vw, 64px);
    padding: 24px;
    border: 1.5px solid var(--ink);
    border-radius: 12px;
    max-width: 52em;
  }

  .plain__title {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .plain__legal {
    color: var(--pencil);
  }

  .plain__legal a {
    color: var(--ink);
    font-weight: 700;
  }

  .plain__legal :global(.icon) {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-left: 3px;
    vertical-align: -0.12em;
  }

  @media (min-width: 900px) {
    .commit__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }

    .nots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
    }
  }
</style>
