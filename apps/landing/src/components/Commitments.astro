---
/**
 * Lo que Blindaje no hace: una lista tipográfica en columnas desiguales, sin cajas ni viñetas. Cada
 * límite en tinta plena y su razón en tinta suave.
 */
import type { Dict } from "../i18n";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const c = d.commitments;
---

<section class="section on-paper-2" id="limites" aria-labelledby="limites-title">
  <div class="wrap grid lim">
    <div class="lim__head" data-reveal>
      <h2 id="limites-title" class="head">{c.title}</h2>
      <p class="soft">{c.lead}</p>
    </div>

    <ul class="lim__list" role="list" data-reveal>
      {
        c.items.map((it) => (
          <li>
            <span class="lim__name">{it.title}</span>
            {it.text && <span class="lim__why soft">{it.text}</span>}
          </li>
        ))
      }
    </ul>

    <div class="lim__honest" data-reveal>
      <p class="lead">{c.honestyTitle}.</p>
      <p>{c.honesty}</p>
      <p class="small soft">
        {c.legal} <a href={c.legalLink.url} rel="noopener noreferrer">{c.legalLink.name}</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .lim {
    row-gap: 48px;
  }

  .lim__head {
    display: grid;
    gap: 16px;
    align-content: start;
    max-width: 24em;
  }

  .lim__list {
    columns: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lim__list li {
    display: grid;
    gap: 4px;
    break-inside: avoid;
    padding-bottom: 28px;
  }

  .lim__name {
    font-size: var(--step-lead);
    line-height: 1.25;
  }

  .lim__honest {
    display: grid;
    gap: 12px;
    max-width: 40em;
  }

  @media (min-width: 720px) {
    .lim__list {
      columns: 2;
      column-gap: 40px;
    }
  }

  @media (min-width: 1100px) {
    .lim__head {
      grid-column: 1 / 4;
    }

    .lim__list {
      grid-column: 5 / 13;
      columns: 3;
    }

    .lim__honest {
      grid-column: 5 / 13;
    }
  }
</style>
