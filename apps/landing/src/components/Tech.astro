---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const t = d.tech;
/** Color de nudo de cada señal, igual que en la consola y en el quipu del hero. */
const signalTone = ["voice", "phrase", "ident", "image", "plain"];
const last = t.pipeline.length - 1;
---

<section class="section field-surface" id="tecnologia" aria-labelledby="tech-title">
  <div class="wrap">
    <div class="head tech__head">
      <h2 id="tech-title" class="h2">{t.title}</h2>
      <p class="lead">{t.lead}</p>
    </div>

    <ol class="cords" role="list" aria-label={t.pipelineLabel}>
      {
        t.pipeline.map((s, i) => (
          <li class:list={["cords__stage", i === last && "cords__stage--human"]}>
            <h3 class="cords__name">{s.stage}</h3>
            <ul class="cords__knots" role="list">
              {s.items.map((it, j) => (
                <li class:list={["cords__knot", i === 2 ? `tone-${signalTone[j]}` : i === last ? "tone-human" : "tone-plain"]}>
                  {it}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="models">
      <h3 class="models__title">{t.modelsTitle}</h3>
      {
        t.groups.map((g) => (
          <div class="models__group">
            <h4 class="models__group-title">{g.title}</h4>
            <ul class="models__list" role="list">
              {g.rows.map((r) => (
                <li>
                  <span class="models__name">{r.name}</span>
                  <span class="models__id mono">{r.id}</span>
                  <span class="models__use">{r.use}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="honest">
      <h3 class="honest__title">
        <Icon name="search" />
        {t.honestTitle}
      </h3>
      {t.honest.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  /* Del archivo a la decisión, como un quipu: la cuerda madre corre por la izquierda en el celular
     y por arriba en escritorio; cada etapa cuelga con sus nudos. */
  .cords {
    --cord-w: 3px;
    position: relative;
    display: grid;
    gap: 28px;
    margin: 0 0 clamp(56px, 7vw, 96px);
    padding: 0;
    list-style: none;
  }

  .cords::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 10px;
    bottom: 8px;
    width: var(--cord-w);
    border-radius: 4px;
    background: var(--cord);
  }

  .cords__stage {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-left: 34px;
  }

  /* El lazo con que cada etapa cuelga de la cuerda madre. */
  .cords__stage::after {
    content: "";
    position: absolute;
    left: 2.5px;
    top: 6px;
    width: 14px;
    height: 14px;
    border: var(--cord-w) solid var(--cord);
    border-radius: 50%;
    background: var(--field);
  }

  .cords__name {
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .cords__knots {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cords__knot {
    position: relative;
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 1.35;
    color: var(--on-field-2);
  }

  .cords__knot::before {
    content: "";
    position: absolute;
    left: -31.5px;
    top: 0.2em;
    width: 14px;
    height: 14px;
    border: 2px solid var(--field);
    border-radius: 50%;
    background: var(--knot, var(--cord));
  }

  .tone-voice {
    --knot: var(--k-voice);
    color: var(--white);
  }

  .tone-ident {
    --knot: var(--k-ident);
    color: var(--white);
  }

  .tone-phrase {
    --knot: var(--k-phrase);
    color: var(--white);
  }

  .tone-image {
    --knot: var(--k-image);
    color: var(--white);
  }

  /* La última etapa es humana: nudos huecos y la letra a mano de la revisora. */
  .tone-human {
    font-family: var(--hand);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--white);
  }

  .tone-human::before {
    top: 0.15em;
    background: var(--field);
    border: var(--cord-w) solid var(--k-voice);
  }

  .models {
    display: grid;
    gap: 28px;
  }

  .models__title {
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  .models__group {
    display: grid;
    gap: 8px;
  }

  .models__group-title {
    font-size: var(--fs-body);
    color: var(--on-field-2);
  }

  .models__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--white);
  }

  .models__list li {
    display: grid;
    gap: 2px 24px;
    padding-block: 14px;
    border-bottom: 1px solid var(--field-line);
  }

  .models__name {
    font-weight: 700;
    font-size: var(--fs-body-l);
  }

  .models__id,
  .models__use {
    color: var(--on-field-2);
  }

  .honest {
    display: grid;
    gap: 10px;
    margin-top: clamp(40px, 5vw, 64px);
    padding: 24px;
    border: 1.5px solid rgb(255 255 255 / 0.45);
    border-radius: 12px;
    max-width: 56em;
  }

  .honest__title {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: var(--fs-title);
    line-height: 1.2;
  }

  .honest p {
    color: var(--on-field-2);
  }

  @media (min-width: 900px) {
    .tech__head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      column-gap: 64px;
      align-items: end;
    }

    .models__list li {
      grid-template-columns: 13rem 14rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  @media (min-width: 1100px) {
    .cords {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 20px;
      padding-top: 30px;
    }

    /* Escritorio: la cuerda madre corre arriba y cada etapa cuelga con su propia cuerda. */
    .cords::before {
      left: 8px;
      right: 0;
      top: 8px;
      bottom: auto;
      width: auto;
      height: var(--cord-w);
    }

    .cords__stage::before {
      content: "";
      position: absolute;
      left: 8px;
      top: -22px;
      bottom: -6px;
      width: var(--cord-w);
      border-radius: 4px;
      background: var(--cord);
    }

    .cords__stage::after {
      top: -28px;
    }
  }
</style>
