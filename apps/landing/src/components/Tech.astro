---
import type { Dict } from "../i18n";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const t = d.tech;
const stateClass = { pipeline: "tag tag--ink", optional: "tag", evaluated: "tag tag--dashed" } as const;
---

<section class="section" id="tecnologia" aria-labelledby="tecnologia-title">
  <div class="wrap">
    <h2 id="tecnologia-title">
      <span class="mlabel">{t.label}<span class="sr-only">. </span></span>
      <span class="h2">{t.title}</span>
    </h2>
    <p class="lead tech__lead">{t.lead}</p>

    <ul class="models" role="list">
      {
        t.rows.map((r) => (
          <li class="model">
            <span class="model__name">
              <span class="model__title" translate="no">{r.name}</span>
              <span class="model__id" lang={/^[a-z0-9.-]+$|weights|Meta open/.test(r.id) ? "en" : undefined} translate="no">{r.id}</span>
            </span>
            <span class="model__role">{r.role}</span>
            <span class="model__state">
              <span class={stateClass[r.state]}>{t.states[r.state]}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="tech__note">{t.thirdParty}</p>

    <div class="agents">
      <h3 class="agents__title">{t.agentsTitle}</h3>
      <p class="agents__lead">{t.agentsLead}</p>
      <ol class="agents__list" role="list">
        {
          t.agents.map((a) => (
            <li class="agent">
              <span class="agent__name">{a.name}</span>
              <span class="agent__text">{a.text}</span>
              <span class="agent__approves">
                <span class="agent__label">{t.approvesLabel}</span> {a.approves}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="agents__rules">{t.rules}</p>
    </div>
  </div>
</section>

<style>
  .tech__lead {
    margin-top: 24px;
  }

  .models {
    list-style: none;
    margin: 44px 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .model {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .model__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
  }

  .model__title {
    font-weight: 700;
    font-size: var(--fs-body-l);
  }

  .model__id {
    font-size: var(--fs-caption);
    color: var(--pencil);
  }

  .model__role {
    max-width: 34em;
  }

  .model__state {
    font-size: var(--fs-caption);
  }

  .tag {
    display: inline-block;
    padding: 2px 10px;
    border: 1.5px solid var(--pencil);
    border-radius: 999px;
    font-weight: 700;
    color: var(--pencil);
    white-space: nowrap;
  }

  .tag--ink {
    border-color: var(--ink);
    color: var(--ink);
  }

  .tag--dashed {
    border-style: dashed;
  }

  .tech__note {
    margin-top: 16px;
    max-width: 38em;
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .agents {
    margin-top: 72px;
    display: grid;
    gap: 12px;
  }

  .agents__title {
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }

  .agents__lead {
    max-width: 34em;
    color: var(--pencil);
  }

  .agents__list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .agent {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }

  .agent__name {
    font-family: var(--hand);
    font-weight: 700;
    font-size: var(--fs-hand);
    line-height: 1.15;
  }

  .agent__text {
    max-width: 33em;
  }

  .agent__approves {
    font-weight: 700;
  }

  .agent__label {
    font-weight: 400;
    color: var(--pencil);
  }

  .agents__rules {
    margin-top: 8px;
    max-width: 38em;
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .model {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) 9.5rem;
      column-gap: 32px;
      align-items: baseline;
    }

    .model__name {
      flex-direction: column;
      align-items: flex-start;
    }

    .model__state {
      justify-self: end;
    }

    .agent {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) minmax(0, 14rem);
      column-gap: 32px;
      align-items: baseline;
    }
  }
</style>
