---
/**
 * Hecho con Meta AI: un titular a todo el ancho, el diagrama del pipeline (de la evidencia a la
 * decisión, con los modelos de Meta en añil) y, empujadas a la derecha, dos tablas tipográficas
 * (modelos y agentes). A la izquierda, abajo, un quipu colgado: datos anudados, cinco siglos antes.
 */
import type { Dict } from "../i18n";
import Photo from "./Photo.astro";
import Pipeline from "./Pipeline.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const t = d.page.tech;
---

<section class="section" id="tecnologia" aria-labelledby="tecnologia-title">
  <div class="wrap grid tech">
    <h2 id="tecnologia-title" class="display tech__title" data-reveal>
      <span>{t.title[0]}</span>
      <span>{t.title[1]}</span>
    </h2>

    <div class="tech__pipe">
      <Pipeline dict={d} />
    </div>

    <figure class="tech__photo" data-reveal>
      <Photo name="khipuColgante" alt={d.page.photos.khipuColgante!.alt} sizes="(min-width: 1100px) 26vw, 60vw" widths={[480, 800, 1200]} />
      <figcaption class="cap">{d.page.photos.khipuColgante!.caption}</figcaption>
    </figure>

    <div class="tech__tables">
      <p class="lead" data-reveal><span>{t.lead}</span></p>

      <table class="tbl" data-reveal>
        <caption class="tbl__name">{t.modelsLabel}</caption>
        {
          t.groups.map((g) => (
            <tbody>
              {g.rows.map((row, i) => (
                <tr>
                  <th scope="row" class="tbl__kind soft">{i === 0 ? g.kind : <span class="sr-only">{g.kind}</span>}</th>
                  <td class="tbl__name-cell">{row.name}</td>
                  <td class="tbl__value">{row.use}</td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>

      <table class="tbl" data-reveal>
        <caption class="tbl__name">{t.agentsLabel}</caption>
        <thead class="sr-only">
          <tr>
            <th scope="col">{t.agentsLabel}</th>
            <th scope="col"></th>
            <th scope="col">{t.approves}</th>
          </tr>
        </thead>
        <tbody>
          {
            t.agents.map((a) => (
              <tr>
                <th scope="row" class="tbl__kind">{a.name}</th>
                <td class="tbl__name-cell soft">{a.what}</td>
                <td class="tbl__value">
                  <span class="soft">{t.approves}:</span> {a.approves}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="tech__honest small soft" data-reveal>
        <p><strong class="tech__honest-title">{d.tech.honestTitle}.</strong></p>
        {d.tech.honest.map((h) => <p>{h}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .tech {
    row-gap: 56px;
  }

  .tech__title span {
    display: block;
  }

  .tech__photo {
    max-width: 380px;
  }

  .tech__photo :global(img) {
    aspect-ratio: 4 / 5;
    object-position: top;
  }

  .tech__tables {
    display: grid;
    gap: 56px;
    align-content: start;
  }

  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-body);
    line-height: 1.35;
  }

  .tbl__name {
    caption-side: top;
    text-align: left;
    padding-bottom: 12px;
    font-style: italic;
    color: var(--ink-2);
  }

  .tbl th,
  .tbl td {
    padding: 0 0 14px;
    text-align: left;
    vertical-align: baseline;
    font-weight: 400;
  }

  .tbl tbody + tbody tr:first-child > * {
    padding-top: 28px;
  }

  .tbl__kind {
    width: 32%;
    padding-right: 16px;
  }

  .tbl__name-cell {
    padding-right: 16px;
  }

  .tbl__value {
    text-align: right !important;
  }

  .tech__honest {
    display: grid;
    gap: 8px;
    max-width: 40em;
  }

  .tech__honest-title {
    color: var(--ink);
  }

  /* En el celular cada fila apila el tipo arriba y el nombre con su uso abajo. */
  @media (max-width: 719px) {
    .tbl tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 12px;
      padding-bottom: 14px;
    }

    .tbl th,
    .tbl td {
      padding: 0;
      width: auto;
    }

    .tbl__kind {
      grid-column: 1 / -1;
    }

    .tbl__kind:has(.sr-only) {
      display: none;
    }

    .tbl tbody + tbody tr:first-child > * {
      padding-top: 0;
    }

    .tbl tbody + tbody tr:first-child {
      padding-top: 16px;
    }
  }

  @media (min-width: 1100px) {
    .tech__title {
      grid-column: 1 / 13;
    }

    .tech__title span:first-child {
      padding-left: 3vw;
    }

    .tech__photo {
      grid-column: 1 / 5;
      grid-row: 3;
      position: sticky;
      top: 32px;
      align-self: start;
      max-width: none;
    }

    .tech__tables {
      grid-column: 7 / 13;
      grid-row: 3;
    }
  }
</style>
