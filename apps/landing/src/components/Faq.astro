---
/**
 * Preguntas frecuentes de un dirigente antes de pedir un piloto. Desplegables nativos: funcionan sin
 * JavaScript y con el teclado. Cada respuesta sale de lo que la página ya afirma, sin promesas nuevas.
 */
import type { Dict } from "../i18n";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const f = d.lp.faq;
---

<section class="section" id="preguntas" aria-labelledby="preguntas-title">
  <div class="wrap faq">
    <div class="faq__head" data-reveal>
      <h2 id="preguntas-title" class="head">{f.title}</h2>
      <p class="lead soft">{f.lead}</p>
    </div>

    <div class="faq__list" data-reveal>
      {
        f.items.map((it) => (
          <details class="qa">
            <summary>
              <span>{it.q}</span>
              <span class="qa__sign" aria-hidden="true" />
            </summary>
            <p class="soft">{it.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 40px;
  }

  .faq__head {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .faq__list {
    border-top: 1px solid var(--rule);
  }

  .qa {
    border-bottom: 1px solid var(--rule);
  }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
    padding: 16px 0;
    font-size: var(--step-lead);
    font-weight: 700;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa summary:hover {
    color: var(--field-2);
  }

  .qa summary:focus-visible {
    outline-color: var(--field);
    outline-offset: 4px;
  }

  /* Un más que se vuelve menos: dos trazos, el vertical se pliega al abrir. */
  .qa__sign {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--paper-2);
  }

  .qa__sign::before,
  .qa__sign::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    border-radius: 1px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }

  .qa__sign::after {
    transform: rotate(90deg);
  }

  .qa[open] .qa__sign {
    background: var(--mark);
  }

  .qa[open] .qa__sign::after {
    transform: rotate(0deg);
  }

  .qa p {
    max-width: 38em;
    padding: 0 56px 24px 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .qa[open] p {
      animation: qa-in 0.35s var(--ease);
    }
  }

  @keyframes qa-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (min-width: 960px) {
    .faq {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 64px;
      align-items: start;
    }

    .faq__head {
      position: sticky;
      top: 80px;
    }
  }
</style>
