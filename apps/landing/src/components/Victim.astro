---
/**
 * Cómo guarda la evidencia la víctima: una sola columna de lectura colgada del eje, cada párrafo con
 * su entrada en negrita y, debajo de algunos, su prueba: la app por fuera y por dentro y lo que
 * Blindaje encuentra. Si hay capturas reales del celular en docs/screenshots/, se muestran esas; si
 * no, fragmentos de interfaz dibujados y rotulados como ilustración.
 */
import { Picture } from "astro:assets";
import type { Dict } from "../i18n";
import { findShot } from "../lib/screenshots";
import Photo from "./Photo.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const v = d.page.victim;
const il = d.actors.victim.illo;
const outside = findShot("outside");
const inside = findShot("inside") ?? findShot("report");
const real = outside && inside;
/** "Por dentro: tus notas privadas" → "Tus notas privadas". */
const tail = il.inside.split(":").pop()?.trim() ?? il.inside;
const notesTitle = tail.charAt(0).toUpperCase() + tail.slice(1);
---

<section class="section" id="como-funciona" aria-labelledby="como-title">
  <div class="wrap grid vic">
    <figure class="vic__photo" data-reveal>
      <Photo name="mototaxisLambayeque" alt={d.page.photos.mototaxisLambayeque!.alt} sizes="(min-width: 1100px) 32vw, 90vw" widths={[480, 800, 1200]} />
      <figcaption class="cap">{d.page.photos.mototaxisLambayeque!.caption}</figcaption>
    </figure>

    <div class="vic__col">
      <div data-reveal><h2 id="como-title" class="head">{v.title}</h2></div>

      {
        v.runIns.map((r, i) => (
          <div class="stage" data-reveal>
            <p>
              <strong>{r.lead}</strong> <span class="soft">{r.text}</span>
            </p>
            {i === 1 &&
              (real ? (
                <div class="pair">
                  {[
                    { s: outside, alt: d.actors.victim.shotOutsideAlt, label: il.outside },
                    { s: inside, alt: d.actors.victim.shotInsideAlt, label: il.inside },
                  ].map((x) => (
                    <figure>
                      <Picture
                        src={x.s!.image}
                        alt={x.alt}
                        formats={["webp"]}
                        fallbackFormat="webp"
                        widths={[240, 360, 480].filter((w) => w <= x.s!.image.width)}
                        sizes="(min-width: 1100px) 260px, 44vw"
                        loading="lazy"
                        decoding="async"
                      />
                      <figcaption class="cap">{x.label}</figcaption>
                    </figure>
                  ))}
                </div>
              ) : (
                <figure class="pair" aria-label={il.label}>
                  <div class="ui ui--ledger" data-ui>
                    <p class="ui__title">{il.ledgerTitle}</p>
                    <ul role="list">
                      {il.ledger.map((row) => (
                        <li>
                          <span>{row.item}</span>
                          <span class="num">{row.amount}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="ui__total">
                      <span>{il.totalLabel}</span>
                      <span class="num">{il.total}</span>
                    </p>
                  </div>
                  <div class="ui ui--notes" data-ui>
                    <p class="ui__title">{notesTitle}</p>
                    <ul role="list">
                      {il.evidence.map((e) => (
                        <li class={`ev ev--${e.kind}`}>{e.text}</li>
                      ))}
                    </ul>
                    <p class="ui__case">{il.caseLabel}</p>
                  </div>
                  <figcaption class="cap pair__cap">{il.note}</figcaption>
                </figure>
              ))}
            {i === 3 && (
              <div class="ui ui--found" data-ui>
                <p class="ui__title">{v.foundTitle}</p>
                <ul role="list">
                  {il.found.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vic {
    row-gap: 56px;
  }

  .vic__photo {
    order: 2;
    max-width: 520px;
  }

  .vic__photo :global(img) {
    aspect-ratio: 4 / 5;
  }

  .vic__col {
    display: grid;
    gap: 40px;
    align-content: start;
    max-width: 600px;
  }

  .vic__col > div:first-child {
    margin-bottom: 8px;
  }

  .stage {
    display: grid;
    gap: 20px;
  }

  .stage p {
    line-height: 1.6;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }

  .pair__cap {
    grid-column: 1 / -1;
    margin-top: 0;
  }

  /* Fragmentos de interfaz: la letra y los bordes de la app real. */
  .ui {
    padding: 16px;
    border-radius: 12px;
    background: #fff;
    color: #1d2433;
    font-family: var(--ui);
    font-size: 0.875rem;
    line-height: 1.4;
    box-shadow: 0 0 0 1px rgb(20 26 43 / 0.12); /* taste-skill-ignore: fragmento data-ui */
  }

  .ui ul {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .ui__title {
    font-weight: 700;
  }

  .ui--ledger li,
  .ui__total {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .ui__total {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #d9dde5; /* taste-skill-ignore: fragmento data-ui */
    font-weight: 700;
  }

  .ui--notes {
    background: #1d2433;
    color: #f5f6f8;
    box-shadow: none; /* taste-skill-ignore: fragmento data-ui */
  }

  .ev {
    padding-left: 12px;
    border-left: 3px solid #f2c94c;
  }

  .ev--phrase {
    border-left-color: #f2a1bd;
  }

  .ev--image {
    border-left-color: #9dbbf2;
  }

  .ui__case {
    margin-top: 12px;
    font-weight: 700;
    color: #f2c94c;
  }

  .ui--found ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ui--found li {
    padding: 4px 10px;
    border-radius: 6px;
    background: #fff1b8;
    font-weight: 700;
  }

  @media (max-width: 479px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1100px) {
    .vic__photo {
      order: 0;
      max-width: none;
      grid-column: 1 / 5;
      grid-row: 1;
      position: sticky;
      top: 32px;
      align-self: start;
    }

    .vic__col {
      grid-column: 6 / 12;
      grid-row: 1;
    }
  }
</style>
