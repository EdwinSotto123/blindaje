---
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";
import Screenshot from "./Screenshot.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const v = d.victim;
const icons = ["key", "exit", "bellOff", "mic", "search", "file"] as const;
---

<section class="section band" id="victima" aria-labelledby="victima-title">
  <div class="wrap">
    <h2 id="victima-title">
      <span class="mlabel">{v.label}<span class="sr-only">. </span></span>
      <span class="h2">{v.title}</span>
    </h2>
    <p class="lead victim__lead">{v.lead}</p>

    <div class="victim__grid">
      <ul class="feats" role="list">
        {
          v.features.map((f, i) => (
            <li class="feat">
              <span class="feat__icon" aria-hidden="true">
                <Icon name={icons[i] ?? "check"} />
              </span>
              <span class="feat__body">
                <span class="feat__title">{f.title}</span>
                <span class="feat__text">{f.text}</span>
                {i === 4 && (
                  <span class="found">
                    <span class="found__caption">{v.found.caption}</span>
                    {v.found.chips.map((c) => (
                      <span class="hl found__chip">{c}</span>
                    ))}
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="victim__shots">
        <figure>
          <Screenshot slot="outside" alt={v.shotOutsideAlt} lang={d.lang} width={208} tilt="left" />
          <figcaption>{v.shotOutside}</figcaption>
        </figure>
        <figure>
          <Screenshot slot="report" alt={v.shotReportAlt} lang={d.lang} width={208} tilt="right" />
          <figcaption>{v.shotReport}</figcaption>
        </figure>
      </div>
    </div>

    <div class="consent sheet">
      <h3 class="consent__title">{v.consentTitle}</h3>
      <dl class="consent__list">
        {
          v.consent.map((c, i) => (
            <div class="consent__item">
              <dt>
                {c.title} <span class:list={["hl", i === 1 && "hl--mint"]}>{c.tag}</span>
              </dt>
              <dd>{c.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="consent__cloud">
        <Icon name="lock" />
        <span>{v.cloud}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .victim__lead {
    margin-top: 24px;
  }

  .victim__grid {
    display: grid;
    gap: 48px;
    margin-top: 44px;
  }

  .feats {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .feat {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    min-height: 64px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .feat__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
  }

  .feat__body {
    display: grid;
    gap: 2px;
  }

  .feat__title {
    font-weight: 700;
    font-size: var(--fs-body-l);
  }

  .feat__text {
    color: var(--pencil);
  }

  .found {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin-top: 8px;
  }

  .found__caption {
    font-size: var(--fs-small);
    color: var(--pencil);
  }

  .found__chip {
    border-radius: 8px;
    padding: 4px 10px;
    font-size: var(--fs-small);
  }

  .victim__shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }

  .victim__shots figure {
    display: grid;
    gap: 16px;
  }

  .victim__shots figcaption {
    font-family: var(--hand);
    font-size: var(--fs-body);
    line-height: 1.3;
    text-align: center;
  }

  .consent {
    margin-top: 56px;
    padding: 22px;
    display: grid;
    gap: 16px;
  }

  .consent__title {
    font-size: var(--fs-title);
    line-height: 1.25;
  }

  .consent__list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .consent__item {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
  }

  .consent__item dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-weight: 700;
    font-size: var(--fs-body-l);
  }

  .consent__item dt .hl {
    font-size: var(--fs-caption);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .consent__item dd {
    margin: 4px 0 0;
    color: var(--pencil);
    max-width: 34em;
  }

  .consent__cloud {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 38em;
  }

  .consent__cloud :global(.icon) {
    margin-top: 0.2em;
  }

  @media (min-width: 720px) {
    .consent {
      padding: 28px 32px;
    }

    .consent__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }

  @media (min-width: 1024px) {
    .victim__grid {
      grid-template-columns: minmax(0, 1fr) 440px;
      column-gap: clamp(40px, 5vw, 80px);
    }
  }
</style>
