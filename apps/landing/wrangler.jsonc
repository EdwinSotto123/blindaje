// Landing de Blindaje: sitio estático (Astro) servido por Workers Static Assets.
// Despliegue: `pnpm --filter @blindaje/landing deploy` (build + wrangler deploy).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blindaje-landing",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
