{
  "name": "@blindaje/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:mock": "pnpm run build:mock && wrangler deploy"
  },
  "dependencies": {
    "@blindaje/shared": "workspace:*",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.154.0"
  }
}
