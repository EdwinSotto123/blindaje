// Portal de negocios de Blindaje: SPA estática servida por Workers Static Assets.
// Despliegue: `pnpm --filter @blindaje/portal deploy:mock` (modo simulado) o
// `VITE_API_URL=https://… pnpm --filter @blindaje/portal deploy` (API real).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blindaje-negocios",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
